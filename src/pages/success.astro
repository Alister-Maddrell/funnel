---
import Layout from "../layouts/Layout.astro";
---

<Layout title="You're in! — Ster Maddrell" description="Your deposit has been received. Fill in the quick form to get started.">
  <div class="px-5 pt-28 pb-12">
    <div class="mx-auto max-w-xl text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-grey-100 border border-grey-200/60 mb-8">
        <svg class="w-7 h-7 text-highlight" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="font-display text-[clamp(2.5rem,6vw,3.5rem)] leading-[1.05] tracking-[-0.02em] text-black">
        You're in!
      </h1>
      <p class="mt-4 text-lg text-grey-500 leading-relaxed">
        Your deposit has been received. Check your email for next steps — or fill in the form below to get started right away.
      </p>
    </div>
  </div>

  <!-- Tally form embed — seamless, no scrollbar -->
  <div class="mx-auto max-w-2xl px-5 pb-20">
    <iframe
      data-tally-src="https://tally.so/embed/pbGZdZ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="0"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Client intake form"
      style="overflow: hidden;"
    ></iframe>
    <script src="https://tally.so/widgets/embed.js"></script>

    <div class="mt-12 text-center">
      <a href="/" class="text-sm text-grey-400 hover:text-dark transition-colors">
        ← Back to homepage
      </a>
    </div>
  </div>
</Layout>
