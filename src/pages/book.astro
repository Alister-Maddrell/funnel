---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Book a Call — Alister Maddrell" description="Book a free 15-minute discovery call to discuss your website project.">
  <div class="px-5 pt-28 pb-12">
    <div class="mx-auto max-w-xl text-center">
      <!-- Hand-drawn calendar illustration -->
      <svg class="w-14 h-14 mx-auto mb-6" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="10" width="48" height="40" rx="8" stroke="#1a3a5c" stroke-width="1.5" fill="none"/>
        <path d="M4 22 L52 22" stroke="#1a3a5c" stroke-width="1" opacity="0.3"/>
        <path d="M16 4 L16 14" stroke="#1a3a5c" stroke-width="2" stroke-linecap="round"/>
        <path d="M40 4 L40 14" stroke="#1a3a5c" stroke-width="2" stroke-linecap="round"/>
        <circle cx="20" cy="32" r="3" fill="#5cbd6a" opacity="0.3"/>
        <circle cx="28" cy="32" r="3" fill="#1a3a5c" opacity="0.15"/>
        <circle cx="36" cy="32" r="3" fill="#1a3a5c" opacity="0.15"/>
        <circle cx="20" cy="40" r="3" fill="#1a3a5c" opacity="0.15"/>
        <circle cx="28" cy="40" r="3" fill="#f5c542" opacity="0.3"/>
      </svg>
      <h1 class="font-display text-[clamp(2rem,5vw,3rem)] leading-[1.08] tracking-[-0.02em] text-black">
        Let's talk about your project
      </h1>
      <p class="mt-4 text-[16px] text-grey-500 leading-relaxed max-w-md mx-auto">
        Book a free 15-minute discovery call. No pressure, no obligation. Just a chat about what you need.
      </p>
    </div>
  </div>

  <!-- Cal.com embed -->
  <div class="mx-auto max-w-3xl px-5 pb-20">
    <div class="bg-grey-50 rounded-3xl border-[1.5px] border-grey-200/40 p-3 md:p-4">
      <div class="bg-white rounded-2xl overflow-hidden" style="min-height: 600px;">
        <iframe
          src="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call?embed=true&layout=month_view&hideBranding=true"
          width="100%"
          height="700"
          frameborder="0"
          style="border: none; overflow: hidden;"
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="text-sm text-grey-400">
        Prefer email? <a href="mailto:alistermaddrell@gmail.com" class="font-semibold text-dark underline decoration-grey-300 underline-offset-2 hover:decoration-dark transition-colors">alistermaddrell@gmail.com</a>
      </p>
    </div>

    <div class="mt-6 text-center">
      <a href="/" class="text-sm text-grey-400 hover:text-dark transition-colors">
        ← Back to homepage
      </a>
    </div>
  </div>
</Layout>
