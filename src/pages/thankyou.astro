---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank you — Alister Maddrell" description="Your form has been submitted. I'll be in touch soon.">
  <div class="min-h-screen flex flex-col items-center justify-center px-5 py-20">
    <div class="mx-auto max-w-xl text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-grey-100 border border-grey-200/60 mb-8">
        <svg class="w-7 h-7 text-highlight" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="font-display text-[clamp(2.5rem,6vw,3.5rem)] leading-[1.05] tracking-[-0.02em] text-black">
        Thank you!
      </h1>
      <p class="mt-4 text-lg text-grey-500 leading-relaxed">
        Your details have been received. I'll review everything and be in touch within 48 hours.
      </p>
      <p class="mt-8 text-sm text-grey-400">
        Redirecting to homepage in <span id="countdown">10</span> seconds...
      </p>
      <a href="/" class="mt-4 inline-block text-sm text-grey-400 underline decoration-grey-200 underline-offset-2 hover:text-dark transition-colors">
        Go now →
      </a>
    </div>
  </div>
</Layout>

<script>
  const countdownEl = document.getElementById('countdown');
  let seconds = 10;
  const interval = setInterval(() => {
    seconds--;
    if (countdownEl) countdownEl.textContent = String(seconds);
    if (seconds <= 0) {
      clearInterval(interval);
      window.location.href = '/';
    }
  }, 1000);
</script>
