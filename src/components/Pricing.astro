---
const inclusions = [
  "Designed from scratch — not a template",
  "Mobile-first responsive design",
  "Under 2 second load times",
  "Booking or contact form built in",
  "SEO foundations for Google",
  "Simple CMS for easy updates",
  "2 revision rounds included",
  "3 months hosting + support"
];
---

<!-- Cal.com-style pricing section -->
<section id="pricing" class="cal-section">
  <div class="cal-section-inner">
    <!-- Header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-green" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 1a.75.75 0 01.75.75v.99l.975-.342a.75.75 0 01.5 1.414l-1.475.518v1.14l.988-.571a.75.75 0 01.75 1.3L9.5 6.77v1.04l1.475.519a.75.75 0 01-.5 1.414L9.5 9.4v.99a.75.75 0 01-1.5 0V9.4l-.975.342a.75.75 0 01-.5-1.414L8 7.81V6.77l-.988-.571a.75.75 0 01.75-1.3l.988.571V4.33L7.275 3.812a.75.75 0 11.5-1.414l.975.342V1.75A.75.75 0 018 1z"/></svg>
        Pricing
      </div>
      <h2 class="cal-h2">One package. Everything included.</h2>
      <p class="cal-subtext">No hidden fees. No monthly surprises. One price for a complete, professional website.</p>
    </div>

    <!-- Pricing card -->
    <div class="cal-card fade-in">
      <div class="p-6 sm:p-8">
        <!-- Price -->
        <div class="mb-6">
          <div class="font-display text-[48px] sm:text-[56px] font-bold tracking-tight text-dark leading-none">$1,999</div>
          <p class="text-[14px] text-grey-500 mt-1">Everything you need to get online</p>
        </div>

        <!-- CTA -->
        <a href="/api/create-checkout" class="flex items-center justify-center gap-1.5 w-full py-3 rounded-lg bg-dark text-white text-[14px] font-medium hover:bg-black transition-colors mb-4">
          Get started — $999 deposit
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        </a>
        <p class="text-[12px] text-grey-400 text-center mb-6">Remaining $1,000 due on launch</p>

        <!-- Divider -->
        <div class="border-t border-grey-200 pt-6">
          <!-- Inclusions -->
          <ul class="flex flex-col gap-3">
            {inclusions.map((item) => (
              <li class="flex items-start gap-3 text-[14px] text-grey-700">
                <svg class="w-4.5 h-4.5 text-green flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Trust badges footer -->
      <div class="flex items-center justify-center gap-6 px-6 py-4 border-t border-grey-200 bg-grey-50">
        <div class="flex items-center gap-1.5 text-[12px] text-grey-400">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          Secure via Stripe
        </div>
        <div class="w-px h-4 bg-grey-200"></div>
        <div class="flex items-center gap-1.5 text-[12px] text-grey-400">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          No lock-in contracts
        </div>
      </div>
    </div>

    <!-- Extra CTA -->
    <div class="mt-6 text-center fade-in">
      <p class="text-[13px] text-grey-400">Need something more complex?</p>
      <a href="/book" class="text-[13px] font-medium text-dark hover:underline">Let's talk →</a>
    </div>
  </div>
</section>
