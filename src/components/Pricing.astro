---
const inclusions = [
  { text: "Designed from scratch — not a template", icon: "blue" },
  { text: "Mobile-first responsive design", icon: "green" },
  { text: "Under 2 second load times", icon: "amber" },
  { text: "Booking or contact form built in", icon: "purple" },
  { text: "SEO foundations for Google", icon: "orange" },
  { text: "Simple CMS for easy updates", icon: "teal" },
  { text: "2 revision rounds included", icon: "blue" },
  { text: "3 months hosting + support", icon: "green" },
];

const stripeCheckoutUrl = "/api/create-checkout";
---

<section id="pricing" class="py-16 md:py-28 px-5 bg-grey-50">
  <div class="mx-auto max-w-3xl text-center mb-10 md:mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5">
      <!-- Price tag illustration -->
      <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
        <path d="M2 2h6l6 6-6 6-6-6V2z" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.2"/>
        <circle cx="5.5" cy="5.5" r="1" fill="#22c55e"/>
      </svg>
      Pricing
    </div>
    <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
      One package. Everything included.
    </h2>
    <p class="mt-4 text-[14px] md:text-[16px] text-grey-500 leading-relaxed max-w-md mx-auto">
      No hidden fees. No monthly surprises. One price for a complete, professional website.
    </p>
  </div>

  <div class="mx-auto max-w-md">
    <div class="bg-white rounded-2xl border border-grey-200/60 shadow-lg overflow-hidden">
      <!-- Price header -->
      <div class="px-7 pt-8 pb-6 text-center border-b border-grey-100 relative overflow-hidden">
        <!-- Decorative colored circles -->
        <div class="absolute -top-4 -right-4 w-20 h-20 rounded-full bg-blue/5"></div>
        <div class="absolute -bottom-6 -left-6 w-16 h-16 rounded-full bg-orange/5"></div>
        <p class="font-display text-[56px] md:text-[64px] tracking-[-0.03em] text-dark leading-none relative">{`$1,999`}</p>
        <p class="mt-2 text-[13px] text-grey-400 relative">Everything you need to get online</p>
      </div>

      <!-- Inclusions -->
      <div class="px-7 py-7">
        <ul class="space-y-3.5">
          {inclusions.map((item) => (
            <li class="flex items-start gap-3 text-[13px] md:text-[14px] text-grey-600 leading-relaxed">
              <svg class="w-4 h-4 text-green shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
              {item.text}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a href={stripeCheckoutUrl} class="btn-accent">
            Get started — $999 deposit
          </a>
          <p class="mt-3 text-center text-[11px] text-grey-400">
            Remaining $1,000 due on launch
          </p>
        </div>
      </div>
    </div>

    <!-- Trust indicators -->
    <div class="flex items-center justify-center gap-5 mt-6 flex-wrap">
      <span class="flex items-center gap-1.5 text-[11px] text-grey-400">
        <svg class="w-3.5 h-3.5 text-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Secure via Stripe
      </span>
      <span class="flex items-center gap-1.5 text-[11px] text-grey-400">
        <svg class="w-3.5 h-3.5 text-blue" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        No lock-in contracts
      </span>
    </div>

    <p class="mt-5 text-center text-[13px] text-grey-500">
      Need something more complex?
      <a href="/book" class="font-semibold text-dark underline decoration-grey-300 underline-offset-2 hover:decoration-dark transition-colors">Let's talk.</a>
    </p>
  </div>
</section>
