---
const inclusions = [
  "Designed from scratch. Not a template, not a theme.",
  "Mobile-first. Built for the screen your customers actually use.",
  "Loads in under 2 seconds. Faster than your competitors.",
  "Booking or contact form. Enquiries come straight to you.",
  "SEO foundations. So Google knows you exist.",
  "Simple CMS. Update your own text and images without calling me.",
  "2 revision rounds. We refine until it feels right.",
  "3 months hosting + support. You're covered after launch.",
];

const stripeCheckoutUrl = "/api/create-checkout";
---

<!-- Layer 1: White section bg -->
<section id="pricing" class="py-14 md:py-28 px-4 md:px-5 bg-white">
  <div class="mx-auto max-w-2xl">
    <div class="text-center mb-12">
      <!-- Hand-drawn price tag illustration -->
      <svg class="w-12 h-12 mx-auto mb-5" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6 24 L24 6 L42 6 L42 24 L24 42 Z" stroke="#1a3a5c" stroke-width="1.5" fill="#1a3a5c" opacity="0.03" stroke-linejoin="round"/>
        <circle cx="34" cy="14" r="3" stroke="#5cbd6a" stroke-width="1.5" fill="#5cbd6a" opacity="0.15"/>
        <path d="M20 20 L20 30 M16 22 C16 18, 24 18, 24 22 S16 26, 16 30 C16 34, 24 34, 24 30" stroke="#1a3a5c" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      </svg>
      <div class="tag mb-6">Pricing</div>
      <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
        One package. Everything included.
      </h2>
    </div>

    <!-- Layer 2: Outer card shell -->
    <div class="rounded-3xl bg-grey-50 border border-grey-200/40 shadow-lg p-3 md:p-4">
      <!-- Layer 3: Inner white card -->
      <div class="bg-white rounded-2xl overflow-hidden">
        <!-- Price header inset -->
        <div class="px-8 pt-10 pb-8 text-center border-b border-grey-100">
          <p class="font-display text-[4.5rem] md:text-[5.5rem] tracking-[-0.03em] text-black leading-none">$1,999</p>
          <p class="mt-3 text-sm text-grey-400">Everything you need to get online</p>
        </div>

        <div class="px-8 py-8">
          <ul class="space-y-4">
            {inclusions.map((item) => (
              <li class="flex items-start gap-3 text-[14px] text-grey-600 leading-relaxed">
                <svg class="w-4.5 h-4.5 text-highlight shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-10">
            <a
              href={stripeCheckoutUrl}
              class="btn-accent"
            >
              Let's go. $999 deposit.
            </a>
            <p class="mt-4 text-center text-xs text-grey-400">
              7 days start · 5 days content · 2 revisions
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust indicators -->
    <div class="flex items-center justify-center gap-6 mt-8 flex-wrap">
      <span class="flex items-center gap-1.5 text-xs text-grey-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Secure payment via Stripe
      </span>
      <span class="flex items-center gap-1.5 text-xs text-grey-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        No lock-in contracts
      </span>
    </div>

    <p class="mt-6 text-center text-sm text-grey-500">
      Need e-commerce, booking systems, or something more complex?
      <a
        href="/book"
        class="font-semibold text-dark underline decoration-grey-300 underline-offset-2 hover:decoration-dark transition-colors"
      >
        Let's talk.
      </a>
    </p>
  </div>
</section>
