---
const solutions = [
  {
    title: "Show up first",
    text: "When someone nearby searches for what you do, your business is right there.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>`,
  },
  {
    title: "Look sharp everywhere",
    text: "Phone, tablet, laptop. Pixel perfect on every screen your customers use.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3"/></svg>`,
  },
  {
    title: "Load before they blink",
    text: "Under 2 seconds. No spinner, no waiting, no lost sales.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  },
  {
    title: "Take bookings 24/7",
    text: "Enquiries, appointments, and orders come in around the clock. Even on your day off.",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>`,
  },
];
---

<section id="solution" class="relative py-20 md:py-28 px-5 bg-grey-50 grain">
  <div class="mx-auto max-w-5xl">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">The Solution</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      A website that sells while you sleep
    </h2>
    <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-5">
      {solutions.map((s) => (
        <div class="card-elevated p-6 md:p-8">
          <div class="w-10 h-10 rounded-xl bg-grey-900 text-white flex items-center justify-center" set:html={s.icon} />
          <h3 class="mt-4 text-base font-bold text-black">{s.title}</h3>
          <p class="mt-2 text-sm text-grey-600 leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
