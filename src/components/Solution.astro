---
const solutions = [
  {
    title: "Show up first",
    text: "When someone nearby searches for what you do, your business is right there.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="10" stroke="#1a3a5c" stroke-width="1.5" stroke-dasharray="3 2"/><path d="M21 21L28 28" stroke="#1a3a5c" stroke-width="2"/><circle cx="14" cy="14" r="4" fill="#5cbd6a" opacity="0.15"/><path d="M14 10v8M10 14h8" stroke="#5cbd6a" stroke-width="1"/></svg>`,
  },
  {
    title: "Look sharp everywhere",
    text: "Phone, tablet, laptop. Pixel perfect on every screen your customers use.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="16" height="28" rx="4" stroke="#1a3a5c" stroke-width="1.5"/><path d="M14 26h4" stroke="#1a3a5c" stroke-width="1.5"/><rect x="10" y="6" width="12" height="16" rx="1" fill="#1a3a5c" opacity="0.04"/><path d="M13 12h6M13 15h4" stroke="#1a3a5c" stroke-width="0.75" opacity="0.3"/><circle cx="4" cy="8" r="1.5" fill="#f5c542" opacity="0.5"/><circle cx="28" cy="14" r="1" fill="#e8635a" opacity="0.4"/></svg>`,
  },
  {
    title: "Load before they blink",
    text: "Under 2 seconds. No spinner, no waiting, no lost sales.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 2L8 18h7l-2 12 12-18h-8l3-10z" stroke="#1a3a5c" stroke-width="1.5" fill="#f5c542" opacity="0.1"/><path d="M16 2L8 18h7l-2 12 12-18h-8l3-10z" stroke="#f5c542" stroke-width="1.5" fill="none"/><circle cx="4" cy="20" r="1" fill="#1a3a5c" opacity="0.1"/></svg>`,
  },
  {
    title: "Take bookings 24/7",
    text: "Enquiries, appointments, and orders come in around the clock. Even on your day off.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="26" height="22" rx="4" stroke="#1a3a5c" stroke-width="1.5"/><path d="M3 13h26" stroke="#1a3a5c" stroke-width="1" opacity="0.3"/><path d="M10 2v6M22 2v6" stroke="#1a3a5c" stroke-width="1.5"/><circle cx="10" cy="19" r="2" fill="#5cbd6a" opacity="0.3"/><circle cx="16" cy="19" r="2" fill="#1a3a5c" opacity="0.15"/><circle cx="22" cy="19" r="2" fill="#1a3a5c" opacity="0.15"/><circle cx="10" cy="24" r="2" fill="#1a3a5c" opacity="0.15"/></svg>`,
  },
];
---

<!-- Layer 1: Grey section background -->
<section id="solution" class="py-24 md:py-32 px-5 bg-grey-50">
  <div class="mx-auto max-w-4xl">
    <div class="md:flex md:items-start md:justify-between md:gap-16 mb-16">
      <div class="md:max-w-md">
        <!-- Hand-drawn lightbulb illustration -->
        <svg class="w-12 h-12 mb-5" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4 C14 4, 8 12, 8 20 C8 26, 12 30, 16 34 L16 38 L32 38 L32 34 C36 30, 40 26, 40 20 C40 12, 34 4, 24 4Z" stroke="#1a3a5c" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
          <path d="M18 42 L30 42" stroke="#1a3a5c" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M20 46 L28 46" stroke="#1a3a5c" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M24 8 L24 14" stroke="#f5c542" stroke-width="2" stroke-linecap="round"/>
          <path d="M16 12 L20 16" stroke="#f5c542" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M32 12 L28 16" stroke="#f5c542" stroke-width="1.5" stroke-linecap="round"/>
          <!-- Sparkle rays -->
          <path d="M4 18 L8 20" stroke="#1a3a5c" stroke-width="0.75" opacity="0.3"/>
          <path d="M44 18 L40 20" stroke="#1a3a5c" stroke-width="0.75" opacity="0.3"/>
          <circle cx="6" cy="10" r="1" fill="#f5c542" opacity="0.4"/>
          <circle cx="42" cy="12" r="1.5" fill="#f5c542" opacity="0.3"/>
        </svg>
        <div class="tag mb-6">The solution</div>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] text-black">
          A website that sells while you sleep
        </h2>
      </div>
      <p class="mt-4 md:mt-6 text-grey-500 leading-relaxed max-w-sm md:text-right text-sm">
        Your site should be your hardest-working employee. Always on, always converting.
      </p>
    </div>

    <!-- 2x2 grid but with visual interest — alternating alignment -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 fade-in-stagger">
      {solutions.map((s, i) => (
        <!-- Layer 2: White card -->
        <div class={`group rounded-2xl bg-white border border-grey-200/60 shadow-card p-3 transition-all duration-200 hover:shadow-card-hover fade-in ${i % 2 === 1 ? 'sm:translate-y-4' : ''}`}>
          <!-- Layer 3: Inner content area -->
          <div class="p-5 md:p-6">
            <div class="w-12 h-12" set:html={s.icon} />
            <h3 class="mt-5 text-[15px] font-bold text-dark">{s.title}</h3>
            <p class="mt-2 text-sm text-grey-500 leading-relaxed">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Section connector -->
  <div class="relative h-px bg-grey-200/50 mt-24 md:mt-32 mx-5">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white border border-grey-200/60 flex items-center justify-center">
      <span class="text-[10px] text-grey-300">+</span>
    </div>
  </div>
</section>
