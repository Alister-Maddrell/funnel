---
const solutions = [
  {
    title: "Show up first",
    text: "When someone nearby searches for what you do, your business is right there.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" stroke="#1a3a5c" stroke-width="1.5"/><path d="M16 16l5 5" stroke="#1a3a5c" stroke-width="2"/><circle cx="11" cy="11" r="3" fill="#5cbd6a" opacity="0.2"/></svg>`,
  },
  {
    title: "Look sharp everywhere",
    text: "Phone, tablet, laptop. Pixel perfect on every screen your customers use.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="3" stroke="#1a3a5c" stroke-width="1.5"/><path d="M10 19h4" stroke="#1a3a5c" stroke-width="1.5"/></svg>`,
  },
  {
    title: "Load before they blink",
    text: "Under 2 seconds. No spinner, no waiting, no lost sales.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L6 14h6l-1 8 8-12h-6l1-8z" stroke="#f5c542" stroke-width="1.5" fill="#f5c542" fill-opacity="0.1"/></svg>`,
  },
  {
    title: "Take bookings 24/7",
    text: "Enquiries, appointments, and orders come in around the clock. Even on your day off.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" stroke="#1a3a5c" stroke-width="1.5"/><path d="M3 10h18M8 2v4M16 2v4" stroke="#1a3a5c" stroke-width="1.5"/><circle cx="8" cy="15" r="1.5" fill="#5cbd6a" opacity="0.4"/></svg>`,
  },
];
---

<section id="solution" class="py-14 md:py-28 px-4 md:px-5 bg-grey-50">
  <div class="mx-auto max-w-4xl">
    <div class="md:flex md:items-start md:justify-between md:gap-16 mb-10 md:mb-16">
      <div class="md:max-w-md">
        <div class="w-11 h-11 rounded-xl bg-white border-[1.5px] border-grey-200/50 flex items-center justify-center mb-5">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C8 2 5 6 5 10c0 3 2 5.5 4 7.5V20h6v-2.5c2-2 4-4.5 4-7.5 0-4-3-8-7-8z" stroke="#f5c542" stroke-width="1.5" fill="none"/>
            <path d="M9 22h6" stroke="#f5c542" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="tag mb-4">The solution</div>
        <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
          A website that sells while you sleep
        </h2>
      </div>
      <p class="hidden md:block mt-6 text-[14px] text-grey-500 leading-[1.6] max-w-sm text-right">
        Your site should be your hardest-working employee. Always on, always converting.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4 fade-in-stagger">
      {solutions.map((s, i) => (
        <div class={`group rounded-2xl bg-white border-[1.5px] border-grey-200/50 shadow-card p-3 transition-all duration-200 hover:shadow-card-hover fade-in ${i % 2 === 1 ? 'md:translate-y-4' : ''}`}>
          <div class="p-4 md:p-6">
            <!-- Icon in container -->
            <div class="w-10 h-10 rounded-xl bg-grey-50 border border-grey-200/40 flex items-center justify-center">
              <div class="w-5 h-5" set:html={s.icon} />
            </div>
            <h3 class="mt-4 text-[15px] font-semibold text-dark">{s.title}</h3>
            <p class="mt-1.5 text-[13px] md:text-[14px] text-grey-500 leading-[1.6]">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="relative h-px bg-grey-200/50 mt-14 md:mt-28 mx-4 md:mx-5">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-lg bg-grey-50 border-[1.5px] border-grey-200/50 flex items-center justify-center">
      <span class="text-[10px] text-grey-300">+</span>
    </div>
  </div>
</section>
