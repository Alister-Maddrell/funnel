---
const solutions = [
  {
    title: "Show up first",
    text: "When someone nearby searches for what you do, your business is right there.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="20" r="14" stroke-dasharray="3 4"/><path d="M30 30 L42 42"/><path d="M38 42 L42 42 L42 38"/></svg>`,
  },
  {
    title: "Look sharp everywhere",
    text: "Phone, tablet, laptop. Pixel perfect on every screen your customers use.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="4" width="24" height="40" rx="4"/><path d="M20 40 L28 40"/><circle cx="24" cy="8" r="1" fill="currentColor"/></svg>`,
  },
  {
    title: "Load before they blink",
    text: "Under 2 seconds. No spinner, no waiting, no lost sales.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4 L12 26 L22 26 L18 44 L38 18 L26 18 L32 4 Z"/></svg>`,
  },
  {
    title: "Take bookings 24/7",
    text: "Enquiries, appointments, and orders come in around the clock. Even on your day off.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="40" height="34" rx="4"/><path d="M4 20 L44 20"/><path d="M14 4 L14 14"/><path d="M34 4 L34 14"/><circle cx="16" cy="30" r="2" fill="currentColor"/><circle cx="24" cy="30" r="2" fill="currentColor"/><circle cx="32" cy="30" r="2" fill="currentColor"/></svg>`,
  },
];
---

<section id="solution" class="py-20 md:py-28 px-5 bg-grey-50">
  <div class="mx-auto max-w-4xl">
    <!-- Hand-drawn icon -->
    <svg class="w-8 h-8 mb-4 opacity-50" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 8 L32 16" />
      <path d="M16 18 L22 24" />
      <path d="M48 18 L42 24" />
      <circle cx="32" cy="36" r="16" />
      <path d="M24 36 L30 42 L40 30" />
    </svg>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">The Solution</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      A website that sells while you sleep
    </h2>
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {solutions.map((s) => (
        <div class="bg-white rounded-2xl border border-grey-200/60 p-6 md:p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 text-black opacity-70" set:html={s.icon} />
          <h3 class="mt-5 text-base font-bold text-black">{s.title}</h3>
          <p class="mt-2 text-sm text-grey-600 leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
