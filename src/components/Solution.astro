---
const features = [
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    bg: "#eff6ff",
    title: "Show up on Google",
    text: "SEO foundations so customers in your area actually find you."
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01" stroke-width="2" stroke-linecap="round"/></svg>`,
    bg: "#f0fdf4",
    title: "Perfect on every screen",
    text: "Mobile-first design that looks sharp on phone, tablet, and desktop."
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    bg: "#fffbeb",
    title: "Loads instantly",
    text: "Under 2 seconds. No spinner, no waiting, no lost sales."
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    bg: "#f5f3ff",
    title: "Bookings 24/7",
    text: "Enquiries and appointments come in while you sleep."
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="1.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    bg: "#fff7ed",
    title: "You own everything",
    text: "Your code, your domain, your data. No lock-in, ever."
  },
  {
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="1.5"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    bg: "#f0fdfa",
    title: "Easy to update",
    text: "Simple CMS so you can change text and images yourself."
  }
];
---

<!-- Cal.com "Benefits" section style -->
<section id="solution" class="cal-section">
  <div class="cal-section-inner">
    <!-- Header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-green" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 16A8 8 0 108 0a8 8 0 000 16zm3.78-9.72a.75.75 0 00-1.06-1.06L7 8.94 5.28 7.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.06 0l4.25-4.25z"/></svg>
        The solution
      </div>
      <h2 class="cal-h2">A website that works as hard as you do</h2>
      <p class="cal-subtext">Everything your business needs to look professional online and convert visitors into customers.</p>
      <div class="cal-cta-row">
        <a href="/book" class="btn-primary btn-arrow">Get started</a>
        <a href="#pricing" class="btn-secondary btn-arrow">See pricing</a>
      </div>
    </div>

    <!-- Feature cards - cal.com benefit card style -->
    <div class="flex flex-col gap-3 fade-in-stagger">
      {features.map((f) => (
        <div class="cal-card-padded flex gap-4 items-start fade-in hover:shadow-md transition-shadow duration-200">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style={`background:${f.bg}`}>
            <Fragment set:html={f.icon} />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-[15px] font-semibold text-dark mb-0.5">{f.title}</h3>
            <p class="text-[13px] leading-relaxed text-grey-500">{f.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Product mockup below features - cal.com style -->
    <div class="mt-8 fade-in">
      <div class="cal-card overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-grey-200 bg-white">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green/60"></span>
          </div>
          <div class="flex-1 mx-3">
            <div class="bg-grey-100 rounded-md px-3 py-1 text-[11px] text-grey-400 text-center font-mono">kingraincafe.com.au</div>
          </div>
        </div>
        <div class="aspect-[16/9] overflow-hidden bg-grey-100">
          <img src="/thumbnails/cafe.webp" alt="Example website - Kin Grain Cafe" loading="lazy" class="w-full h-full object-cover object-top" />
        </div>
      </div>
    </div>
  </div>
</section>
