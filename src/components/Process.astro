---
const steps = [
  {
    num: "1",
    title: "Tell me about your business",
    text: "Fill in a quick form with the basics. Want to go deeper? There's a detailed questionnaire too. Just give me your business name and I'll handle the rest.",
  },
  {
    num: "2",
    title: "I design your layout",
    text: "You see a wireframe of your site before a single line of code is written. Nothing moves forward without your thumbs up.",
  },
  {
    num: "3",
    title: "I build it",
    text: "You get a live preview link. Check it on your phone. Show your partner. Send it to your mum. Make sure it feels right.",
  },
  {
    num: "4",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
  },
];
---

<section id="process" class="relative py-20 md:py-28 px-5 bg-grey-900 grain overflow-hidden">
  <div class="mx-auto max-w-5xl">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/30 mb-3">How It Works</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-white">
      You talk. I build. You launch.
    </h2>
    <div class="mt-12 grid gap-5 md:grid-cols-4">
      {steps.map((s) => (
        <div class="rounded-2xl bg-white/[0.05] border border-white/[0.08] backdrop-blur-sm p-6 md:p-8">
          <span class="text-3xl font-light text-white/30">{s.num}</span>
          <h3 class="mt-3 text-base font-bold text-white">{s.title}</h3>
          <p class="mt-2 text-sm text-white/50 leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 rounded-2xl bg-white/[0.05] border border-white/[0.08] px-8 py-5">
      <p class="text-white/50 text-sm">
        <span class="font-semibold text-white">Your total time commitment: about 30 minutes.</span> I handle literally everything else.
      </p>
    </div>
    <div class="mt-8">
      <a
        href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white text-sm font-semibold hover:bg-white/10 transition-colors"
      >
        Book a free 15-min call
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>
</section>
