---
const steps = [
  {
    num: "1",
    title: "Tell me about your business",
    text: "Fill in a quick form with the basics. Want to go deeper? There's a detailed questionnaire too. Just give me your business name and I'll handle the rest.",
  },
  {
    num: "2",
    title: "I design your layout",
    text: "You see a wireframe of your site before a single line of code is written. Nothing moves forward without your thumbs up.",
  },
  {
    num: "3",
    title: "I build it",
    text: "You get a live preview link. Check it on your phone. Show your partner. Send it to your mum. Make sure it feels right.",
  },
  {
    num: "4",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
  },
];
---

<section id="process" class="py-20 md:py-28 px-5">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      You talk. I build. You launch.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-4">
      {steps.map((s) => (
        <div class="rounded-xl border border-grey-200 bg-white p-5 md:p-6">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-black text-white text-sm font-bold">{s.num}</span>
          <h3 class="mt-4 text-base font-bold text-black">{s.title}</h3>
          <p class="mt-2 text-sm text-grey-600 leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 rounded-xl bg-grey-100 px-6 py-4">
      <p class="text-grey-600 text-sm">
        <span class="font-semibold text-dark">Your total time commitment: about 30 minutes.</span> I handle literally everything else.
      </p>
    </div>
    <div class="mt-8">
      <a
        href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-black text-black text-sm font-semibold hover:bg-black hover:text-white transition-colors"
      >
        Book a free 15-min call
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>
</section>
