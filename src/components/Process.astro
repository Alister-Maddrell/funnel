---
const steps = [
  {
    num: "01",
    title: "Tell me about your business",
    text: "Fill in a quick form with the basics. Want to go deeper? There's a detailed questionnaire too. Just give me your business name and I'll handle the rest.",
  },
  {
    num: "02",
    title: "I design your layout",
    text: "You see a wireframe of your site before a single line of code is written. Nothing moves forward without your thumbs up.",
  },
  {
    num: "03",
    title: "I build it",
    text: "You get a live preview link. Check it on your phone. Show your partner. Send it to your mum. Make sure it feels right.",
  },
  {
    num: "04",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
  },
];
---

<section id="process" class="py-20 md:py-28 px-5 bg-grey-50">
  <div class="mx-auto max-w-4xl">
    <!-- Hand-drawn icon -->
    <svg class="w-8 h-8 mb-4 opacity-50" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 56 L8 12 L24 12" />
      <path d="M8 36 L32 36" />
      <circle cx="36" cy="12" r="8" />
      <path d="M32 12 L36 16 L44 8" />
      <circle cx="44" cy="36" r="8" />
      <path d="M40 36 L44 40 L52 32" />
      <circle cx="32" cy="52" r="8" stroke-dasharray="3 3" />
    </svg>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">How It Works</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      You talk. I build. You launch.
    </h2>

    <!-- Timeline layout instead of cards -->
    <div class="mt-14 relative">
      <!-- Vertical line on desktop -->
      <div class="hidden md:block absolute left-[28px] top-4 bottom-4 w-px bg-grey-200"></div>

      <div class="space-y-10">
        {steps.map((s) => (
          <div class="flex gap-6 md:gap-8 items-start">
            <div class="shrink-0 w-14 h-14 rounded-2xl bg-white border border-grey-200 flex items-center justify-center text-sm font-bold text-grey-400 relative z-10">
              {s.num}
            </div>
            <div class="pt-2">
              <h3 class="text-lg font-bold text-black">{s.title}</h3>
              <p class="mt-1.5 text-sm text-grey-600 leading-relaxed max-w-md">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 bg-white rounded-2xl border border-grey-200/60 px-6 py-5">
      <p class="text-grey-600 text-sm">
        <span class="font-semibold text-black">Your total time commitment: about 30 minutes.</span> I handle literally everything else.
      </p>
    </div>
    <div class="mt-8">
      <a
        href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-grey-200 text-black text-sm font-semibold hover:bg-white hover:border-grey-400 transition-all"
      >
        Book a free 15-min call
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>
</section>
