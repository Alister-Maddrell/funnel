---
const steps = [
  {
    num: "01",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/><path d="M8 12h8M12 8v8" stroke="#3b82f6" stroke-width="2" stroke-linecap="round"/></svg>`,
    color: "#3b82f6",
    title: "Tell me about your business",
    text: "Quick form with the basics. I handle the rest — content, photos, structure.",
  },
  {
    num: "02",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" fill="#fff7ed" stroke="#f97316" stroke-width="1.5"/><path d="M7 8h10M7 12h6" stroke="#f97316" stroke-width="1.5" stroke-linecap="round"/><path d="M7 16h3" stroke="#fdba74" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    color: "#f97316",
    title: "I design your layout",
    text: "You approve a wireframe before any code is written. Nothing moves without your OK.",
  },
  {
    num: "03",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><rect x="4" y="11" width="16" height="10" rx="2" fill="#f5f3ff" stroke="#8b5cf6" stroke-width="1.5"/><path d="M9 15l2 2 4-4" stroke="#8b5cf6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 3l-4 6h8L8 3z" fill="#f5f3ff" stroke="#8b5cf6" stroke-width="1" stroke-linejoin="round" opacity="0.5"/><path d="M16 3l-4 6h8l-4-6z" fill="#f5f3ff" stroke="#8b5cf6" stroke-width="1" stroke-linejoin="round" opacity="0.5"/></svg>`,
    color: "#8b5cf6",
    title: "I build it",
    text: "Live preview link. Check it on your phone. Show your partner. Make sure it feels right.",
  },
  {
    num: "04",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.5"/><path d="M8 12l3 3 5-6" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    color: "#22c55e",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
  },
];
---

<section id="process" class="py-16 md:py-28 px-5 bg-white">
  <div class="mx-auto max-w-3xl text-center mb-10 md:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-grey-50 border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5">
      <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
        <circle cx="3" cy="3" r="2" fill="#3b82f6"/>
        <circle cx="8" cy="6" r="2" fill="#f97316"/>
        <circle cx="13" cy="9" r="2" fill="#8b5cf6"/>
        <circle cx="8" cy="13" r="2" fill="#22c55e"/>
        <path d="M4.5 4l2.5 1.5M9.5 7.5l2.5 1M11.5 10.5l-2.5 1.5" stroke="#e5e7eb" stroke-width="1" stroke-linecap="round"/>
      </svg>
      How it works
    </div>
    <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
      You talk. I build. You launch.
    </h2>
    <p class="mt-4 text-[14px] md:text-[16px] text-grey-500 leading-relaxed max-w-md mx-auto">
      Your total time commitment: about 30 minutes. I handle everything else.
    </p>
  </div>

  <div class="mx-auto max-w-xl" id="timeline-container">
    <div class="relative">
      <!-- Timeline track (background) -->
      <div class="absolute left-[23px] top-0 bottom-0 w-[2px] bg-grey-200/60 rounded-full"></div>
      <!-- Timeline progress (animated fill) -->
      <div id="timeline-progress" class="absolute left-[23px] top-0 w-[2px] rounded-full transition-none" style="height: 0; background: linear-gradient(to bottom, #3b82f6, #f97316, #8b5cf6, #22c55e);"></div>

      <div class="space-y-0">
        {steps.map((s, i) => (
          <div class="timeline-step relative flex gap-5 pb-8 last:pb-0" data-step={i} data-color={s.color}>
            <!-- Node -->
            <div class="relative z-10 w-[48px] shrink-0 flex flex-col items-center">
              <div class="timeline-node w-11 h-11 rounded-xl bg-white border-2 border-grey-200 flex items-center justify-center transition-all duration-500" data-color={s.color}>
                <Fragment set:html={s.icon} />
              </div>
            </div>
            <!-- Content -->
            <div class="timeline-content pt-1.5 pb-6 opacity-50 translate-y-2 transition-all duration-500">
              <span class="inline-block text-[10px] font-bold tracking-wider text-grey-300 uppercase mb-1">Step {s.num}</span>
              <h3 class="text-[16px] font-semibold text-dark leading-snug">{s.title}</h3>
              <p class="mt-1.5 text-[13px] md:text-[14px] text-grey-500 leading-relaxed">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href="/book" class="btn-secondary group">
        Book a free 15-min call
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('timeline-container');
  const progress = document.getElementById('timeline-progress');
  const steps = document.querySelectorAll('.timeline-step');

  if (container && progress && steps.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const step = entry.target as HTMLElement;
          const content = step.querySelector('.timeline-content') as HTMLElement;
          const node = step.querySelector('.timeline-node') as HTMLElement;
          const color = step.dataset.color || '#3b82f6';

          // Activate step
          if (content) {
            content.classList.remove('opacity-50', 'translate-y-2');
            content.classList.add('opacity-100', 'translate-y-0');
          }
          if (node) {
            node.style.borderColor = color;
            node.style.boxShadow = `0 0 0 4px ${color}18`;
          }

          // Update progress bar height
          const containerRect = container.getBoundingClientRect();
          const stepRect = step.getBoundingClientRect();
          const nodeHeight = 44; // h-11 = 44px
          const relativeTop = stepRect.top - containerRect.top + container.scrollTop;
          const targetHeight = relativeTop + nodeHeight / 2;
          progress.style.height = `${targetHeight}px`;
        }
      });
    }, {
      threshold: 0.4,
      rootMargin: '0px 0px -20% 0px'
    });

    steps.forEach((step) => observer.observe(step));
  }
</script>
