---
const steps = [
  {
    num: "01",
    title: "Tell me about your business",
    text: "Quick form with the basics. I handle the rest — content, photos, structure.",
    color: "#3b82f6",
    bg: "#eff6ff"
  },
  {
    num: "02",
    title: "I design your layout",
    text: "You approve a wireframe before any code is written. Nothing moves without your OK.",
    color: "#f97316",
    bg: "#fff7ed"
  },
  {
    num: "03",
    title: "I build it",
    text: "Live preview link. Check it on your phone. Show your partner. Make sure it feels right.",
    color: "#8b5cf6",
    bg: "#f5f3ff"
  },
  {
    num: "04",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
    color: "#22c55e",
    bg: "#f0fdf4"
  }
];
---

<!-- Cal.com "How it works" section — numbered cards with timeline -->
<section id="process" class="cal-section">
  <div class="cal-section-inner">
    <!-- Header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-purple" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0zM8 0a8 8 0 100 16A8 8 0 008 0zm.5 4.75a.75.75 0 00-1.5 0v3.5a.75.75 0 00.37.65l2.5 1.5a.75.75 0 00.76-1.3L8.5 7.88V4.75z"/></svg>
        How it works
      </div>
      <h2 class="cal-h2">You talk. I build. You launch.</h2>
      <p class="cal-subtext">Your total time commitment: about 30 minutes. I handle everything else.</p>
      <div class="cal-cta-row">
        <a href="/book" class="btn-primary btn-arrow">Get started</a>
        <a href="/book" class="btn-secondary btn-arrow">Book a demo</a>
      </div>
    </div>

    <!-- Step cards - cal.com numbered style -->
    <div class="flex flex-col gap-4 fade-in-stagger">
      {steps.map((s) => (
        <div class="cal-card-padded fade-in process-step" data-color={s.color}>
          <!-- Step number badge -->
          <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg mb-3" style={`background:${s.bg}`}>
            <span class="text-[12px] font-bold" style={`color: ${s.color}`}>{s.num}</span>
          </div>
          <h3 class="text-[17px] font-bold text-dark mb-1.5">{s.title}</h3>
          <p class="text-[14px] leading-relaxed text-grey-500">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-step {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .process-step.active {
    border-color: var(--step-color, #3b82f6);
    box-shadow: 0 0 0 1px var(--step-color, #3b82f6), 0 4px 12px rgba(0,0,0,0.06);
  }
</style>

<script>
  const steps = document.querySelectorAll('.process-step');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const el = entry.target as HTMLElement;
        if (entry.isIntersecting) {
          el.classList.add('active');
          el.style.setProperty('--step-color', el.dataset.color || '#3b82f6');
        } else {
          el.classList.remove('active');
        }
      });
    },
    { threshold: 0.6 }
  );
  steps.forEach((s) => observer.observe(s));
</script>
