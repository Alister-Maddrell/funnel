---
const steps = [
  {
    num: "01",
    title: "Tell me about your business",
    text: "Fill in a quick form with the basics. Want to go deeper? There's a detailed questionnaire too. Just give me your business name and I'll handle the rest.",
  },
  {
    num: "02",
    title: "I design your layout",
    text: "You see a wireframe of your site before a single line of code is written. Nothing moves forward without your thumbs up.",
  },
  {
    num: "03",
    title: "I build it",
    text: "You get a live preview link. Check it on your phone. Show your partner. Send it to your mum. Make sure it feels right.",
  },
  {
    num: "04",
    title: "You're live",
    text: "Domain connected, site launched. Customers start finding you.",
  },
];
---

<!-- Layer 1: Grey section bg -->
<section id="process" class="py-24 md:py-32 px-5 bg-grey-50">
  <div class="mx-auto max-w-5xl">
    <div class="md:text-center md:max-w-xl md:mx-auto mb-16">
      <!-- Hand-drawn roadmap illustration -->
      <svg class="w-14 h-14 mb-5 mx-auto" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 48 C8 32, 20 28, 28 24 S48 16, 48 8" stroke="#1a3a5c" stroke-width="1.5" stroke-dasharray="4 4" fill="none"/>
        <circle cx="8" cy="48" r="5" fill="#5cbd6a" opacity="0.2" stroke="#5cbd6a" stroke-width="1.5"/>
        <circle cx="8" cy="48" r="2" fill="#5cbd6a"/>
        <circle cx="22" cy="32" r="4" fill="#f5c542" opacity="0.2" stroke="#f5c542" stroke-width="1.5"/>
        <circle cx="22" cy="32" r="1.5" fill="#f5c542"/>
        <circle cx="36" cy="20" r="4" fill="#1a3a5c" opacity="0.15" stroke="#1a3a5c" stroke-width="1.5"/>
        <circle cx="36" cy="20" r="1.5" fill="#1a3a5c"/>
        <circle cx="48" cy="8" r="5" fill="#e8635a" opacity="0.15" stroke="#e8635a" stroke-width="1.5"/>
        <path d="M46 6 L48 8 L52 4" stroke="#e8635a" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <div class="tag mb-6">How it works</div>
      <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] text-black">
        You talk. I build. You launch.
      </h2>
    </div>

    <!-- Layer 2: White container card wrapping all steps -->
    <div class="bg-white rounded-3xl border border-grey-200/60 shadow-card p-4 md:p-6">
      <div class="grid sm:grid-cols-2 gap-3 fade-in-stagger">
        {steps.map((s) => (
          <!-- Layer 3: Inner grey step cards -->
          <div class="group bg-grey-50 rounded-2xl border border-grey-200/30 p-6 md:p-7 transition-all hover:bg-grey-100/80 fade-in">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white border border-grey-200/60 text-[11px] font-bold text-grey-400 mb-4">{s.num}</span>
            <h3 class="text-[15px] font-bold text-dark">{s.title}</h3>
            <p class="mt-2 text-sm text-grey-500 leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 bg-white rounded-2xl border border-grey-200/60 shadow-card px-6 py-5 md:text-center">
      <p class="text-grey-500 text-sm">
        <span class="font-semibold text-dark">Your total time commitment: about 30 minutes.</span> I handle literally everything else.
      </p>
    </div>

    <div class="mt-8 md:text-center">
      <a
        href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary group"
      >
        Book a free 15-min call
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>

  <!-- Section connector -->
  <div class="relative h-px bg-grey-200/50 mt-24 md:mt-32 mx-5">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-grey-50 border border-grey-200/60 flex items-center justify-center">
      <span class="text-[10px] text-grey-300">+</span>
    </div>
  </div>
</section>
