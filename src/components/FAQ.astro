---
const faqs = [
  {
    q: "How long until my site is live?",
    a: "Most sites launch within 10 business days of receiving your content.",
  },
  {
    q: "I don't have photos or copy. Is that a problem?",
    a: "Not at all. I can source photography and write your content as an add-on. Or just send what you have and I'll work with it.",
  },
  {
    q: "Do I need to know anything technical?",
    a: "Zero. You tell me about your business. I do the rest.",
  },
  {
    q: "Can I edit the site myself after launch?",
    a: "Yes. Every site comes with a simple editor. Change text, swap images. No coding, no calling me.",
  },
  {
    q: "What happens after launch?",
    a: "3 months of hosting and support is included. After that, ongoing support is available monthly.",
  },
  {
    q: "What if I don't love the design?",
    a: "You approve the layout before I write a line of code. Then two rounds of revisions to get every detail right.",
  },
  {
    q: "I've got questions but I'm not ready to pay.",
    a: 'No worries. <a href="/book" class="font-semibold text-dark underline decoration-grey-300 underline-offset-2 hover:decoration-dark">Book a free 15-min call</a>. Zero pressure, zero obligation.',
  },
];
---

<section id="faq" class="py-16 md:py-28 px-5 bg-white">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-10 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-grey-50 border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7" fill="#eff6ff" stroke="#3b82f6" stroke-width="1"/>
          <path d="M6.5 6a1.5 1.5 0 013 0c0 .83-.67 1.15-1 1.5-.33.33-.5.67-.5 1" stroke="#3b82f6" stroke-width="1.2" stroke-linecap="round" fill="none"/>
          <circle cx="8" cy="11" r="0.6" fill="#3b82f6"/>
        </svg>
        FAQ
      </div>
      <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
        Questions? Answers.
      </h2>
    </div>

    <div class="space-y-2.5">
      {faqs.map((faq) => (
        <details class="group rounded-xl border border-grey-200/50 overflow-hidden transition-all [&[open]]:bg-grey-50/50 [&[open]]:border-grey-200/80">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer text-[14px] font-semibold text-dark select-none">
            {faq.q}
            <svg class="w-4 h-4 text-grey-300 shrink-0 ml-4 transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          </summary>
          <div class="px-5 pb-5 text-[13px] md:text-[14px] text-grey-500 leading-relaxed" set:html={faq.a} />
        </details>
      ))}
    </div>
  </div>
</section>
