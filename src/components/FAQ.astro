---
const faqs = [
  {
    q: "How long until my site is live?",
    a: "Most sites launch within 10 business days of receiving your content.",
  },
  {
    q: "I don't have photos or copy. Is that a problem?",
    a: "Not at all. I can source photography and write your content as an add-on. Or just send what you have and I'll work with it.",
  },
  {
    q: "Do I need to know anything technical?",
    a: "Zero. You tell me about your business. I do the rest.",
  },
  {
    q: "Can I edit the site myself after launch?",
    a: "Yes. Every site comes with a simple editor. Change text, swap images. No coding, no calling me.",
  },
  {
    q: "What happens after launch?",
    a: "3 months of hosting and support is included. After that, ongoing support is available monthly.",
  },
  {
    q: "What if I don't love the design?",
    a: "You approve the layout before I write a line of code. Then two rounds of revisions to get every detail right.",
  },
  {
    q: "I've got questions but I'm not ready to pay.",
    a: 'No worries. <a href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call" target="_blank" rel="noopener noreferrer" class="font-semibold text-black underline decoration-grey-400 underline-offset-2 hover:decoration-black">Book a free 15-min call</a>. Zero pressure, zero obligation.',
  },
];
---

<section id="faq" class="relative py-20 md:py-28 px-5 bg-grey-50 grain">
  <div class="mx-auto max-w-5xl flex flex-col md:flex-row gap-12">
    <!-- Left: heading -->
    <div class="md:w-1/3 md:sticky md:top-28 md:self-start">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">FAQ</p>
      <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
        Questions
      </h2>
      <p class="mt-4 text-grey-600 leading-relaxed text-sm">
        Everything you need to know before getting started.
      </p>
    </div>
    <!-- Right: accordion -->
    <div class="md:w-2/3 space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-2xl bg-white shadow-xs overflow-hidden [&[open]]:shadow-sm transition-shadow">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-base font-semibold text-black select-none">
            {faq.q}
            <svg class="w-5 h-5 text-grey-400 shrink-0 ml-4 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-sm text-grey-600 leading-relaxed" set:html={faq.a} />
        </details>
      ))}
    </div>
  </div>
</section>
