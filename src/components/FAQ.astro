---
const faqs = [
  {
    q: "How long until my site is live?",
    a: "Most sites launch within 10 business days of receiving your content.",
  },
  {
    q: "I don't have photos or copy. Is that a problem?",
    a: "Not at all. I can source photography and write your content as an add-on. Or just send what you have and I'll work with it.",
  },
  {
    q: "Do I need to know anything technical?",
    a: "Zero. You tell me about your business. I do the rest.",
  },
  {
    q: "Can I edit the site myself after launch?",
    a: "Yes. Every site comes with a simple editor. Change text, swap images. No coding, no calling me.",
  },
  {
    q: "What happens after launch?",
    a: "3 months of hosting and support is included. After that, ongoing support is available monthly.",
  },
  {
    q: "What if I don't love the design?",
    a: "You approve the layout before I write a line of code. Then two rounds of revisions to get every detail right.",
  },
  {
    q: "I've got questions but I'm not ready to pay.",
    a: `No worries. <a href="/book" class="text-dark font-medium underline underline-offset-2 hover:no-underline">Book a free 15-min call</a>. Zero pressure, zero obligation.`,
  },
];
---

<!-- Cal.com-style FAQ section -->
<section id="faq" class="cal-section">
  <div class="cal-section-inner">
    <!-- Header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-blue" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 15A7 7 0 108 1a7 7 0 000 14zm.75-10.25a.75.75 0 00-1.5 0v.01a.75.75 0 001.5 0v-.01zM8 7a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 018 7z"/></svg>
        FAQ
      </div>
      <h2 class="cal-h2">Questions? Answers.</h2>
    </div>

    <!-- FAQ items -->
    <div class="flex flex-col gap-2 fade-in-stagger">
      {faqs.map((faq) => (
        <details class="cal-card group fade-in">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-[14px] sm:text-[15px] font-medium text-dark select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="pr-4">{faq.q}</span>
            <svg class="w-4 h-4 text-grey-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          </summary>
          <div class="px-5 pb-4 -mt-1">
            <p class="text-[13px] sm:text-[14px] leading-relaxed text-grey-500" set:html={faq.a} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
