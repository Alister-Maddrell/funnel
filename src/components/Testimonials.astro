---
const testimonials = [
  {
    name: "Sarah M.",
    role: "Hartley & Co Plumbing",
    text: "Alister built our site in under two weeks. We went from zero online presence to getting 3-4 enquiries a day. Best money we've spent on the business.",
    rating: 5,
    avatarBg: "bg-blue-light",
    avatarColor: "text-blue",
  },
  {
    name: "James L.",
    role: "Kin Grain Cafe",
    text: "Our old site was embarrassing. The new one loads instantly and looks incredible on phones. Customers tell us they found us on Google now.",
    rating: 5,
    avatarBg: "bg-orange-light",
    avatarColor: "text-orange",
  },
  {
    name: "Michelle T.",
    role: "Apex Fitness",
    text: "I was quoted $8K by two agencies. Alister did it for a quarter of that and the result is better than both their portfolios. No contest.",
    rating: 5,
    avatarBg: "bg-green-light",
    avatarColor: "text-green",
  },
];
---

<section class="py-16 md:py-28 px-5 bg-grey-50">
  <div class="mx-auto max-w-3xl text-center mb-10 md:mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5">
      <div class="flex">
        {[1,2,3,4,5].map(() => (
          <svg class="w-3 h-3 text-amber" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        ))}
      </div>
      Testimonials
    </div>
    <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
      Don't just take my word for it
    </h2>
    <p class="mt-4 text-[14px] md:text-[16px] text-grey-500 leading-relaxed max-w-md mx-auto">
      Here's what business owners say after launching their new site.
    </p>
  </div>

  <div class="mx-auto max-w-4xl grid md:grid-cols-3 gap-4">
    {testimonials.map((t) => (
      <div class="bg-white rounded-2xl border border-grey-200/50 p-6 flex flex-col fade-in">
        <!-- Stars -->
        <div class="flex gap-0.5 mb-4">
          {Array.from({length: t.rating}).map(() => (
            <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <!-- Quote -->
        <p class="text-[13px] md:text-[14px] text-grey-600 leading-relaxed flex-1">"{t.text}"</p>
        <!-- Author -->
        <div class="mt-5 pt-4 border-t border-grey-100 flex items-center gap-3">
          <div class={`w-9 h-9 rounded-full ${t.avatarBg} flex items-center justify-center text-[12px] font-bold ${t.avatarColor}`}>
            {t.name.charAt(0)}
          </div>
          <div>
            <p class="text-[13px] font-semibold text-dark">{t.name}</p>
            <p class="text-[11px] text-grey-400">{t.role}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
