---
const problems = [
  {
    stat: "60%",
    title: "Invisible on mobile",
    text: "of your customers search on their phone. If your site breaks on a small screen, they tap your competitor instead.",
  },
  {
    stat: "50%",
    title: "Too slow to wait for",
    text: "of visitors leave if your site takes more than 3 seconds to load. That's customers walking out of a shop they never entered.",
  },
  {
    stat: "3 in 4",
    title: "Outdated = untrustworthy",
    text: "people judge your business by your website. If it looks like 2015, they assume your business is stuck there too.",
  },
];
---

<!-- Layer 1: White section background -->
<section id="problem" class="py-24 md:py-32 px-5 bg-white">
  <div class="mx-auto max-w-5xl">
    <div class="md:flex md:items-end md:justify-between mb-14">
      <div>
        <svg class="w-7 h-7 mb-5 text-grey-400" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="16" cy="16" r="13" stroke-dasharray="3 4" />
          <path d="M16 10v8" stroke-width="1.5" />
          <circle cx="16" cy="22" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-grey-50 border border-grey-200/60 mb-6">
          <span class="text-xs font-medium text-grey-500">The problem</span>
        </div>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] text-black max-w-lg">
          Your website is costing you more than you think
        </h2>
      </div>
    </div>

    <!-- Bento layout with 3-layer depth -->
    <div class="grid md:grid-cols-5 gap-4">
      <!-- Layer 2: Featured card -->
      <div class="md:col-span-3 bg-grey-50 rounded-2xl p-3 border border-grey-200/40 shadow-card fade-in">
        <!-- Layer 3: Inner white inset -->
        <div class="bg-white rounded-xl p-7 md:p-8 h-full">
          <p class="font-display text-7xl md:text-8xl tracking-tight text-black leading-none">{problems[0].stat}</p>
          <h3 class="mt-5 text-lg font-bold text-dark">{problems[0].title}</h3>
          <p class="mt-2 text-sm text-grey-500 leading-relaxed max-w-sm">{problems[0].text}</p>
        </div>
      </div>

      <!-- Layer 2: Stacked pair -->
      <div class="md:col-span-2 flex flex-col gap-4 fade-in">
        {problems.slice(1).map((p) => (
          <div class="flex-1 bg-grey-50 rounded-2xl p-3 border border-grey-200/40 shadow-card">
            <!-- Layer 3: Inner white inset -->
            <div class="bg-white rounded-xl p-6 h-full">
              <p class="font-display text-4xl tracking-tight text-black">{p.stat}</p>
              <h3 class="mt-3 text-[15px] font-bold text-dark">{p.title}</h3>
              <p class="mt-1.5 text-sm text-grey-500 leading-relaxed">{p.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Section connector -->
  <div class="relative h-px bg-grey-200/50 mt-24 md:mt-32 mx-5">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white border border-grey-200/60 flex items-center justify-center">
      <span class="text-[10px] text-grey-300">+</span>
    </div>
  </div>
</section>
