---
const problems = [
  {
    stat: "60%",
    title: "Invisible on mobile",
    text: "of your customers search on their phone. If your site breaks on a small screen, they tap your competitor instead.",
  },
  {
    stat: "50%",
    title: "Too slow to wait for",
    text: "of visitors leave if your site takes more than 3 seconds to load. That's customers walking out of a shop they never entered.",
  },
  {
    stat: "3 in 4",
    title: "Outdated = untrustworthy",
    text: "people judge your business by your website. If it looks like 2015, they assume your business is stuck there too.",
  },
];
---

<section id="problem" class="py-14 md:py-28 px-4 md:px-5 bg-white">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 md:mb-14">
      <!-- Icon in container -->
      <div class="w-11 h-11 rounded-xl bg-grey-50 border-[1.5px] border-grey-200/50 flex items-center justify-center mb-5">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M12 2 L22 20 L2 20 Z" stroke="#e8635a" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
          <path d="M12 9v4" stroke="#e8635a" stroke-width="2" stroke-linecap="round"/>
          <circle cx="12" cy="16" r="1" fill="#e8635a"/>
        </svg>
      </div>
      <div class="tag mb-4">The problem</div>
      <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark max-w-lg">
        Your website is costing you more than you think
      </h2>
    </div>

    <!-- Bento: featured + stacked pair -->
    <div class="grid md:grid-cols-5 gap-3 md:gap-4">
      <div class="md:col-span-3 bg-grey-50 rounded-2xl p-3 border-[1.5px] border-grey-200/40 shadow-card fade-in">
        <div class="bg-white rounded-xl p-6 md:p-8 h-full">
          <!-- Stat in container -->
          <div class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-grey-50 border border-grey-200/40 mb-4">
            <p class="font-display text-[40px] md:text-[56px] leading-none text-dark">{problems[0].stat}</p>
          </div>
          <h3 class="text-[15px] md:text-[17px] font-semibold text-dark">{problems[0].title}</h3>
          <p class="mt-2 text-[14px] text-grey-500 leading-[1.6] max-w-sm">{problems[0].text}</p>
        </div>
      </div>

      <div class="md:col-span-2 flex flex-col gap-3 md:gap-4 fade-in">
        {problems.slice(1).map((p) => (
          <div class="flex-1 bg-grey-50 rounded-2xl p-3 border-[1.5px] border-grey-200/40 shadow-card">
            <div class="bg-white rounded-xl p-5 md:p-6 h-full">
              <div class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-grey-50 border border-grey-200/40 mb-3">
                <p class="font-display text-[28px] md:text-[32px] leading-none text-dark">{p.stat}</p>
              </div>
              <h3 class="text-[14px] md:text-[15px] font-semibold text-dark">{p.title}</h3>
              <p class="mt-1.5 text-[13px] md:text-[14px] text-grey-500 leading-[1.6]">{p.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="relative h-px bg-grey-200/50 mt-14 md:mt-28 mx-4 md:mx-5">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-lg bg-white border-[1.5px] border-grey-200/50 flex items-center justify-center">
      <span class="text-[10px] text-grey-300">+</span>
    </div>
  </div>
</section>
