---
const problems = [
  {
    icon: `<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
      <rect x="10" y="4" width="20" height="32" rx="4" fill="#fef2f2" stroke="#ef4444" stroke-width="1.5"/>
      <path d="M16 30h8" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round"/>
      <rect x="14" y="10" width="12" height="2" rx="1" fill="#fca5a5"/>
      <rect x="14" y="15" width="8" height="2" rx="1" fill="#fca5a5"/>
      <path d="M26 20L14 20" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 3"/>
      <circle cx="32" cy="8" r="5" fill="#ef4444"/>
      <path d="M32 6v3" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="32" cy="11" r="0.75" fill="white"/>
    </svg>`,
    color: "red",
    stat: "60%",
    title: "Invisible on mobile",
    text: "of customers search on their phone. If your site breaks on mobile, they go to a competitor.",
  },
  {
    icon: `<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
      <circle cx="20" cy="20" r="14" fill="#fffbeb" stroke="#f59e0b" stroke-width="1.5"/>
      <path d="M20 12v8" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
      <path d="M20 20l5.5 5.5" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
      <circle cx="20" cy="20" r="2" fill="#f59e0b"/>
      <path d="M20 8v1" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
      <path d="M20 31v1" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
      <path d="M8 20h1" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
      <path d="M31 20h1" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
    </svg>`,
    color: "amber",
    stat: "50%",
    title: "Too slow to wait",
    text: "of visitors leave if your site takes more than 3 seconds. That's customers who never walked in.",
  },
  {
    icon: `<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none">
      <path d="M20 6L4 34h32L20 6z" fill="#f5f3ff" stroke="#8b5cf6" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M20 16v8" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="20" cy="28" r="1.5" fill="#8b5cf6"/>
      <circle cx="6" cy="10" r="2" fill="#c4b5fd" opacity="0.5"/>
      <circle cx="34" cy="12" r="1.5" fill="#c4b5fd" opacity="0.4"/>
    </svg>`,
    color: "purple",
    stat: "75%",
    title: "Outdated = untrustworthy",
    text: "of people judge your business by your website. If it looks old, they assume your business is too.",
  },
];
---

<section id="problem" class="py-16 md:py-28 px-5 bg-grey-50">
  <div class="mx-auto max-w-3xl text-center mb-10 md:mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5">
      <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
        <path d="M8 2L1.5 13.5h13L8 2z" fill="#fef2f2" stroke="#ef4444" stroke-width="1.2" stroke-linejoin="round"/>
        <path d="M8 6.5v3" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round"/>
        <circle cx="8" cy="11.5" r="0.6" fill="#ef4444"/>
      </svg>
      The problem
    </div>
    <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
      Your website is costing you<br class="hidden sm:block" /> more than you think
    </h2>
    <p class="mt-4 text-[14px] md:text-[16px] text-grey-500 leading-relaxed max-w-lg mx-auto">
      Most small business websites are slow, broken on mobile, and turning customers away every single day.
    </p>
  </div>

  <div class="mx-auto max-w-4xl grid md:grid-cols-3 gap-4">
    {problems.map((p) => (
      <div class="bg-white rounded-2xl border border-grey-200/50 p-6 md:p-7 text-center fade-in">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-grey-50 flex items-center justify-center mb-5">
          <Fragment set:html={p.icon} />
        </div>
        <p class="font-display text-[36px] md:text-[40px] leading-none text-dark mb-2">{p.stat}</p>
        <h3 class="text-[14px] font-semibold text-dark mb-2">{p.title}</h3>
        <p class="text-[13px] text-grey-500 leading-relaxed">{p.text}</p>
      </div>
    ))}
  </div>
</section>
