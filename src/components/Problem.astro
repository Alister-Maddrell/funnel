---
const problems = [
  {
    stat: "60%",
    title: "Invisible on mobile",
    text: "of your customers search on their phone. If your site breaks on a small screen, they tap your competitor instead.",
  },
  {
    stat: "50%",
    title: "Too slow to wait for",
    text: "of visitors leave if your site takes more than 3 seconds to load. That's customers walking out of a shop they never entered.",
  },
  {
    stat: "3 in 4",
    title: "Outdated = untrustworthy",
    text: "people judge your business by your website. If it looks like 2015, they assume your business is stuck there too.",
  },
];
---

<section id="problem" class="py-20 md:py-28 px-5">
  <div class="mx-auto max-w-4xl">
    <!-- Hand-drawn icon -->
    <svg class="w-8 h-8 mb-4 opacity-50" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="32" cy="32" r="26" stroke-dasharray="4 6" />
      <path d="M32 20 L32 36" />
      <circle cx="32" cy="44" r="2" fill="currentColor" />
    </svg>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">The Problem</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black max-w-2xl">
      Your website is costing you more than you think
    </h2>

    <!-- Stacked stat rows instead of cards -->
    <div class="mt-14 space-y-0 divide-y divide-grey-200">
      {problems.map((p) => (
        <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-10 py-8 first:pt-0">
          <div class="md:w-32 shrink-0">
            <p class="text-5xl md:text-6xl font-light tracking-tight text-black">{p.stat}</p>
          </div>
          <div>
            <h3 class="text-base font-bold text-black">{p.title}</h3>
            <p class="mt-1.5 text-sm text-grey-600 leading-relaxed max-w-md">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider mx-5"></div>
