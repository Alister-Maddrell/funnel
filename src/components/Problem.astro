---
const problems = [
  {
    num: "60%",
    title: "Invisible on mobile",
    text: "of customers search on their phone. If your site breaks on mobile, they go to a competitor.",
    bg: "#fef2f2",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01" stroke-width="2" stroke-linecap="round"/></svg>`
  },
  {
    num: "50%",
    title: "Too slow to wait",
    text: "of visitors leave if your site takes more than 3 seconds. That's customers who never walked in.",
    bg: "#fffbeb",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
  },
  {
    num: "75%",
    title: "Outdated = untrustworthy",
    text: "of people judge your business by your website. If it looks old, they assume your business is too.",
    bg: "#f5f3ff",
    icon: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5"><path d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  }
];
---

<!-- Cal.com-style section on page background -->
<section id="problem" class="cal-section">
  <div class="cal-section-inner">
    <!-- Section header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-red" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 00-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 01-1.1 0L7.1 5.995A.905.905 0 018 5zm.002 6a1 1 0 110 2 1 1 0 010-2z"/></svg>
        The problem
      </div>
      <h2 class="cal-h2">Your website is costing you more than you think</h2>
      <p class="cal-subtext">Most small business websites are slow, broken on mobile, and turning customers away every single day.</p>
    </div>

    <!-- Problem cards - cal.com numbered card style -->
    <div class="flex flex-col gap-4 fade-in-stagger">
      {problems.map((p) => (
        <div class="cal-card-padded flex gap-4 items-start fade-in">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style={`background:${p.bg}`}>
            <Fragment set:html={p.icon} />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-display text-[28px] font-bold tracking-tight text-dark leading-none">{p.num}</span>
              <h3 class="text-[15px] font-semibold text-dark">{p.title}</h3>
            </div>
            <p class="text-[13px] leading-relaxed text-grey-500">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
