<!-- Cal.com-style sticky bottom CTA - mobile only -->
<div id="sticky-cta" class="fixed bottom-0 left-0 right-0 z-40 translate-y-full transition-transform duration-300 md:hidden">
  <div class="bg-white/95 backdrop-blur-xl border-t border-grey-200/80 px-4 py-3 safe-bottom">
    <a href="/book" class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-lg bg-dark text-white text-[14px] font-medium hover:bg-black transition-colors">
      Book a free call
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
    </a>
  </div>
</div>

<style>
  .safe-bottom {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
</style>

<script>
  const stickyCta = document.getElementById('sticky-cta');
  const hero = document.getElementById('hero');
  if (hero && stickyCta) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          stickyCta.classList.add('translate-y-full');
          stickyCta.classList.remove('translate-y-0');
        } else {
          stickyCta.classList.remove('translate-y-full');
          stickyCta.classList.add('translate-y-0');
        }
      },
      { threshold: 0 }
    );
    obs.observe(hero);
  }
</script>
