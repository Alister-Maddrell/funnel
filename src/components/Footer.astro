        <a href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call" target="_blank" rel="noopener noreferrer" class="text-sm text-white/40 hover:text-white transition-colors">Book a call</a>
      </nav>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-white/30 mb-4">Contact</p>
      <div class="flex flex-col gap-2.5">
        <a href="mailto:alistermaddrell@gmail.com" class="text-sm text-white/40 hover:text-white transition-colors">alistermaddrell@gmail.com</a>
        <p class="text-sm text-white/40">Sydney, Australia</p>
