---
---

<!-- Cal.com-style pre-footer CTA -->
<section class="cal-section">
  <div class="cal-section-inner">
    <div class="cal-card fade-in">
      <div class="p-8 sm:p-10 text-center">
        <h2 class="font-display text-[28px] sm:text-[36px] font-bold tracking-tight text-dark leading-tight mb-3">
          Ready to get online?
        </h2>
        <p class="text-[14px] sm:text-[15px] text-grey-500 mb-6 max-w-sm mx-auto">
          Stop losing customers to a bad website. Get a site that works as hard as you do.
        </p>
        <div class="flex items-center justify-center gap-3">
          <a href="/book" class="btn-primary btn-arrow">Get started</a>
          <a href="/book" class="btn-secondary btn-arrow">Book a call</a>
        </div>
      </div>

      <!-- Awards / badges row - cal.com style -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 px-6 pb-6">
        <div class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-grey-50 border border-grey-200/50">
          <span class="text-[11px] text-grey-400 font-medium">Hand-coded</span>
          <span class="font-display text-[16px] font-bold text-dark">100%</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-grey-50 border border-grey-200/50">
          <span class="text-[11px] text-grey-400 font-medium">Delivery</span>
          <span class="font-display text-[16px] font-bold text-dark">10 days</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-grey-50 border border-grey-200/50">
          <span class="text-[11px] text-grey-400 font-medium">Load time</span>
          <span class="font-display text-[16px] font-bold text-dark">&lt; 2s</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-grey-50 border border-grey-200/50">
          <span class="text-[11px] text-grey-400 font-medium">Always on</span>
          <span class="font-display text-[16px] font-bold text-dark">24/7</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="px-5 pt-10 pb-8 border-t border-grey-200/40">
  <div class="max-w-[640px] md:max-w-[1000px] mx-auto">
    <!-- Top row -->
    <div class="flex flex-col sm:flex-row gap-8 sm:gap-16 mb-8">
      <!-- Brand -->
      <div class="flex-1">
        <h3 class="font-display text-[20px] font-bold tracking-tight text-dark mb-1">Maddrell Design</h3>
        <p class="text-[13px] text-grey-400 leading-relaxed">Custom websites for local businesses in Sydney.</p>
      </div>

      <!-- Links -->
      <div class="flex gap-12">
        <div>
          <h4 class="text-[11px] font-semibold text-grey-400 uppercase tracking-wider mb-3">Quick links</h4>
          <ul class="flex flex-col gap-2">
            <li><a href="https://portfolio.maddrelldesign.com" target="_blank" rel="noopener" class="text-[13px] text-grey-600 hover:text-dark transition-colors">Portfolio</a></li>
            <li><a href="#pricing" class="text-[13px] text-grey-600 hover:text-dark transition-colors">Pricing</a></li>
            <li><a href="#faq" class="text-[13px] text-grey-600 hover:text-dark transition-colors">FAQ</a></li>
            <li><a href="/book" class="text-[13px] text-grey-600 hover:text-dark transition-colors">Book a call</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-[11px] font-semibold text-grey-400 uppercase tracking-wider mb-3">Contact</h4>
          <ul class="flex flex-col gap-2">
            <li><a href="mailto:alistermaddrell@gmail.com" class="text-[13px] text-grey-600 hover:text-dark transition-colors">alistermaddrell@gmail.com</a></li>
            <li><span class="text-[13px] text-grey-400">Sydney, Australia</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-grey-100 pt-5">
      <p class="text-[12px] text-grey-400">&copy; 2026 Maddrell Design</p>
    </div>
  </div>
</footer>
