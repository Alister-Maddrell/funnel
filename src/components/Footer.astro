---
---

<!-- Pre-footer CTA -->
<section class="py-16 md:py-28 px-5 bg-grey-50 border-t border-grey-200/40">
  <div class="mx-auto max-w-3xl text-center">
    <!-- Rocket illustration -->
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-orange-light mb-6">
      <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none">
        <path d="M16 4c-3 4-5 10-5 16h10c0-6-2-12-5-16z" fill="#fff7ed" stroke="#f97316" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M11 20c-3 0-5 2-5 4l5-1" fill="#fdba74" opacity="0.4"/>
        <path d="M21 20c3 0 5 2 5 4l-5-1" fill="#fdba74" opacity="0.4"/>
        <circle cx="16" cy="14" r="2" fill="#f97316"/>
        <path d="M14 24l-1 5 3-2 3 2-1-5" fill="#f97316" opacity="0.6"/>
        <!-- Sparkles -->
        <circle cx="8" cy="8" r="1.5" fill="#fde68a"/>
        <circle cx="25" cy="6" r="1" fill="#fde68a"/>
        <circle cx="6" cy="16" r="0.75" fill="#93c5fd"/>
        <circle cx="27" cy="14" r="1" fill="#c4b5fd"/>
      </svg>
    </div>

    <h2 class="font-display text-[28px] md:text-[48px] leading-[1.1] text-dark">
      Ready to get online?
    </h2>
    <p class="mt-4 text-[14px] md:text-[16px] text-grey-500 max-w-md mx-auto leading-relaxed">
      Stop losing customers to a bad website. Get a site that works as hard as you do.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="#pricing" class="btn-primary group">
        Get started — $999 deposit
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/book" class="btn-secondary group">
        Book a free call
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- Footer -->
<footer class="py-10 md:py-14 px-5 border-t border-grey-200/40 bg-white">
  <div class="mx-auto max-w-3xl">
    <div class="flex flex-col gap-6">
      <!-- Brand -->
      <div>
        <p class="text-[15px] font-display text-dark">Maddrell Design</p>
        <p class="mt-1 text-[13px] text-grey-400">Custom websites for local businesses in Sydney.</p>
      </div>

      <!-- Links -->
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-10">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-wider text-grey-300 mb-2.5">Quick links</p>
          <div class="flex flex-col gap-2">
            <a href="https://portfolio.maddrelldesign.com" target="_blank" rel="noopener noreferrer" class="text-[13px] text-grey-500 hover:text-dark transition-colors">Portfolio</a>
            <a href="#pricing" class="text-[13px] text-grey-500 hover:text-dark transition-colors">Pricing</a>
            <a href="#faq" class="text-[13px] text-grey-500 hover:text-dark transition-colors">FAQ</a>
            <a href="/book" class="text-[13px] text-grey-500 hover:text-dark transition-colors">Book a call</a>
          </div>
        </div>
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-wider text-grey-300 mb-2.5">Contact</p>
          <div class="flex flex-col gap-2">
            <a href="mailto:alistermaddrell@gmail.com" class="text-[13px] text-grey-500 hover:text-dark transition-colors">alistermaddrell@gmail.com</a>
            <span class="text-[13px] text-grey-400">Sydney, Australia</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-5 border-t border-grey-100">
      <p class="text-[11px] text-grey-300">&copy; 2026 Maddrell Design</p>
    </div>
  </div>
</footer>
