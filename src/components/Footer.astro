---
---

<!-- Pre-footer CTA -->
<section class="py-16 md:py-32 px-5 bg-grey-50 border-t border-grey-200/50">
  <div class="mx-auto max-w-2xl text-center">
    <!-- Hand-drawn rocket illustration -->
    <svg class="w-14 h-14 mx-auto mb-6" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M28 6 C28 6, 16 16, 16 32 L24 36 L32 36 L40 32 C40 16, 28 6, 28 6Z" stroke="#1a3a5c" stroke-width="1.5" fill="#1a3a5c" opacity="0.04"/>
      <path d="M24 36 L20 44 L28 40 L36 44 L32 36" stroke="#e8635a" stroke-width="1.5" fill="#e8635a" opacity="0.1"/>
      <circle cx="28" cy="22" r="4" stroke="#1a3a5c" stroke-width="1" fill="#f5c542" opacity="0.2"/>
      <path d="M12 28 C12 28, 14 24, 16 28" stroke="#1a3a5c" stroke-width="0.75" opacity="0.2"/>
      <path d="M40 28 C40 28, 42 24, 44 28" stroke="#1a3a5c" stroke-width="0.75" opacity="0.2"/>
      <!-- Exhaust sparkles -->
      <circle cx="24" cy="48" r="1.5" fill="#f5c542" opacity="0.3"/>
      <circle cx="32" cy="50" r="1" fill="#e8635a" opacity="0.3"/>
      <circle cx="28" cy="52" r="2" fill="#f5c542" opacity="0.2"/>
    </svg>
    <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] text-black">
      Ready to stop losing customers?
    </h2>
    <p class="mt-4 text-grey-500 max-w-lg mx-auto leading-relaxed text-sm">
      Get a website that works as hard as you do. $999 deposit, live in 10 days.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#pricing"
        class="btn-primary"
      >
        Get started
      </a>
      <a
        href="/book"
        class="btn-secondary"
      >
        Book a free call
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-14 px-5 bg-grey-100 border-t border-grey-200/50">
  <div class="mx-auto max-w-5xl grid md:grid-cols-3 gap-10">
    <div>
      <p class="text-base font-bold tracking-tight text-dark">Maddrell Design</p>
      <p class="mt-2 text-sm text-grey-400 leading-relaxed">Custom websites for local businesses in Sydney.</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-grey-300 mb-4">Quick links</p>
      <nav class="flex flex-col gap-2.5">
        <a href="#portfolio" class="text-sm text-grey-400 hover:text-dark transition-colors">Portfolio</a>
        <a href="#pricing" class="text-sm text-grey-400 hover:text-dark transition-colors">Pricing</a>
        <a href="#faq" class="text-sm text-grey-400 hover:text-dark transition-colors">FAQ</a>
        <a href="/book" class="text-sm text-grey-400 hover:text-dark transition-colors">Book a call</a>
      </nav>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-grey-300 mb-4">Contact</p>
      <div class="flex flex-col gap-2.5">
        <a href="mailto:alistermaddrell@gmail.com" class="text-sm text-grey-400 hover:text-dark transition-colors">alistermaddrell@gmail.com</a>
        <p class="text-sm text-grey-400">Sydney, Australia</p>
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-5xl border-t border-grey-200/50 mt-10 pt-6">
    <p class="text-xs text-grey-300 text-center">
      © 2026 Maddrell Design. Built with care in Sydney.
    </p>
  </div>
</footer>
