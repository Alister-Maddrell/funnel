    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-white/30 mb-4">Quick links</p>
      <nav class="flex flex-col gap-2.5">
        <a href="#portfolio" class="text-sm text-white/40 hover:text-white transition-colors">Portfolio</a>
        <a href="#pricing" class="text-sm text-white/40 hover:text-white transition-colors">Pricing</a>
