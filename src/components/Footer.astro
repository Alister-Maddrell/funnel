<!-- Pre-footer CTA -->
<section class="py-20 md:py-28 px-5 bg-white border-t border-grey-200/50">
  <div class="mx-auto max-w-2xl text-center">
    <!-- Hand-drawn icon -->
    <svg class="w-10 h-10 mx-auto mb-6 opacity-50" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 56 C12 20, 28 8, 56 8" />
      <path d="M44 6 L56 8 L52 20" />
    </svg>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      Ready to stop losing customers?
    </h2>
    <p class="mt-4 text-grey-600 max-w-lg mx-auto leading-relaxed">
      Get a website that works as hard as you do. $999 deposit, live in 10 days.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#pricing"
        class="px-8 py-4 rounded-full bg-black text-white text-base font-semibold hover:bg-grey-800 transition-colors"
