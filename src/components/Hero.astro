---
---

<section id="hero" class="relative overflow-hidden bg-grey-50">
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(0,0,0,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.1) 1px, transparent 1px); background-size: 48px 48px;"></div>

  <div class="relative pt-20 pb-14 md:pt-36 md:pb-24 px-4 md:px-5">
    <div class="mx-auto max-w-4xl bg-white rounded-2xl md:rounded-3xl border-[1.5px] border-grey-200/50 shadow-md px-5 py-10 md:px-14 md:py-16 relative overflow-hidden">

      <!-- Floating illustrations (desktop only) -->
      <div class="hidden md:block absolute top-8 right-8 opacity-60 hero-float" style="animation-delay: 0s;">
        <svg width="80" height="64" viewBox="0 0 80 64" fill="none">
          <rect x="2" y="2" width="76" height="58" rx="8" stroke="#1a3a5c" stroke-width="1.5" fill="none" stroke-dasharray="4 2"/>
          <path d="M2 14 L78 14" stroke="#1a3a5c" stroke-width="1" opacity="0.4"/>
          <circle cx="12" cy="8" r="2.5" fill="#e8635a" opacity="0.7"/>
          <circle cx="20" cy="8" r="2.5" fill="#f5c542" opacity="0.7"/>
          <circle cx="28" cy="8" r="2.5" fill="#5cbd6a" opacity="0.7"/>
          <rect x="10" y="22" width="30" height="3" rx="1.5" fill="#1a3a5c" opacity="0.15"/>
          <rect x="10" y="30" width="22" height="3" rx="1.5" fill="#1a3a5c" opacity="0.1"/>
          <rect x="50" y="22" width="20" height="30" rx="4" fill="#1a3a5c" opacity="0.05" stroke="#1a3a5c" stroke-width="0.75"/>
        </svg>
      </div>
      <div class="hidden md:block absolute bottom-12 right-16 opacity-50 hero-float" style="animation-delay: 1.5s;">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
          <path d="M16 8 L6 24 L16 40" stroke="#1a3a5c" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M32 8 L42 24 L32 40" stroke="#1a3a5c" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M28 4 L20 44" stroke="#1a3a5c" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
        </svg>
      </div>

      <div class="md:max-w-lg">
        <div class="tag mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-highlight animate-pulse"></span>
          Sydney Web Design
        </div>

        <h1 class="font-display text-[36px] md:text-[56px] lg:text-[64px] leading-[1.1] text-dark">
          Stop losing customers to a bad <span class="sketch-underline text-highlight">website</span>
        </h1>

        <p class="mt-5 md:mt-7 text-[15px] md:text-[17px] text-grey-500 leading-[1.6] max-w-md">
          Custom-designed websites for local businesses in Sydney.
          Live in 10 days. <span class="font-semibold text-dark">$1,999 all-in.</span>
        </p>

        <div class="mt-5 inline-flex items-center gap-2.5 px-3 py-2 rounded-xl bg-grey-50 border-[1.5px] border-grey-200/40">
          <div class="w-7 h-7 rounded-lg bg-white border border-grey-200/60 flex items-center justify-center text-[11px] font-bold text-grey-500">A</div>
          <span class="text-[13px] text-grey-400">I'm Alister. Web designer, Sydney.</span>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row items-start gap-3">
          <a href="#portfolio" class="btn-primary group">
            See my work
            <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          </a>
          <a href="/book" class="btn-secondary group">
            Or book a free call
            <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
          </a>
        </div>

        <p class="mt-6 text-[12px] text-grey-300">No lock-in contracts · No templates · No nonsense</p>
      </div>
    </div>
  </div>

  <div class="relative h-px bg-grey-200/50">
    <div class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-7 h-7 rounded-lg bg-grey-50 border-[1.5px] border-grey-200/50 flex items-center justify-center">
      <span class="text-[10px] text-grey-300 font-medium">+</span>
    </div>
  </div>
</section>

<style>
  @keyframes heroFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .hero-float { animation: heroFloat 4s ease-in-out infinite; }
</style>
