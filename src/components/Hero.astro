---
---

<section id="hero" class="relative overflow-hidden bg-white">
  <!-- Strong colour gradient background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 90% 70% at 15% 20%, rgba(59,130,246,0.18) 0%, transparent 55%), radial-gradient(ellipse 70% 60% at 85% 15%, rgba(139,92,246,0.15) 0%, transparent 50%), radial-gradient(ellipse 80% 60% at 50% 80%, rgba(249,115,22,0.12) 0%, transparent 50%), radial-gradient(ellipse 60% 50% at 75% 65%, rgba(34,197,94,0.10) 0%, transparent 45%), radial-gradient(ellipse 50% 40% at 30% 60%, rgba(239,68,68,0.06) 0%, transparent 45%);"></div>
  </div>

  <div class="relative pt-20 pb-8 md:pt-28 md:pb-12 px-5">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/70 border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-5 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Sydney Web Design
      </div>

      <!-- Floating illustrations row — above the title -->
      <div class="flex items-center justify-center gap-5 mb-6" aria-hidden="true">
        <svg class="hero-float w-10 h-10 md:w-12 md:h-12 opacity-[0.45]" viewBox="0 0 60 60" fill="none">
          <path d="M22 14L8 30l14 16" stroke="#3b82f6" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M38 14l14 16-14 16" stroke="#3b82f6" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M26 46l8-32" stroke="#93c5fd" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <svg class="hero-float-slow w-9 h-9 md:w-11 md:h-11 opacity-[0.40]" viewBox="0 0 48 48" fill="none">
          <rect x="12" y="4" width="24" height="40" rx="5" stroke="#8b5cf6" stroke-width="2.5" fill="#f5f3ff"/>
          <path d="M19 38h10" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round"/>
          <rect x="16" y="10" width="16" height="22" rx="2" fill="#c4b5fd" opacity="0.4"/>
        </svg>
        <svg class="hero-float w-10 h-10 md:w-12 md:h-12 opacity-[0.45]" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="18" fill="#fff7ed" stroke="#f97316" stroke-width="2.5"/>
          <circle cx="18" cy="16" r="4.5" fill="#ef4444"/>
          <circle cx="30" cy="16" r="4.5" fill="#3b82f6"/>
          <circle cx="18" cy="30" r="4.5" fill="#22c55e"/>
          <circle cx="30" cy="30" r="4.5" fill="#f59e0b"/>
        </svg>
        <svg class="hero-float-slow w-9 h-9 md:w-11 md:h-11 opacity-[0.40]" viewBox="0 0 40 40" fill="none">
          <path d="M8 6l4 28 8-10 12 4L8 6z" fill="#dcfce7" stroke="#22c55e" stroke-width="2.5" stroke-linejoin="round"/>
        </svg>
        <svg class="hero-float w-10 h-10 md:w-12 md:h-12 opacity-[0.40]" viewBox="0 0 48 48" fill="none">
          <path d="M8 40l2-8L34 8l6 6-24 24-8 2z" fill="#fffbeb" stroke="#f59e0b" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M30 12l6 6" stroke="#f59e0b" stroke-width="2.5"/>
        </svg>
      </div>

      <h1 class="font-display text-[32px] md:text-[60px] lg:text-[72px] leading-[1.08] text-dark tracking-[-0.02em]">
        The better way to<br class="hidden sm:block" />
        <span class="relative">
          <span class="relative z-10">get your business</span>
          <svg class="absolute -bottom-1 left-0 w-full h-3 text-orange/20 z-0" viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M0 8c40-6 80-6 100-2s60 4 100-2" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/></svg>
        </span> online
      </h1>

      <p class="mt-4 md:mt-6 text-[15px] md:text-[17px] text-grey-500 leading-[1.65] max-w-lg mx-auto">
        Custom-designed websites for local businesses in Sydney. Hand-coded, mobile-first, live in 10 days. <span class="font-semibold text-dark">$1,999 all-in.</span>
      </p>

      <!-- CTAs side by side -->
      <div class="mt-6 flex items-center justify-center gap-2.5">
        <a href="#pricing" class="btn-primary group whitespace-nowrap">
          Get started
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/book" class="btn-secondary group whitespace-nowrap">
          Book a free call
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Second row of illustrations — below CTAs, above mockup -->
      <div class="flex items-center justify-center gap-6 mt-6" aria-hidden="true">
        <svg class="hero-float-slow w-10 h-10 md:w-12 md:h-12 opacity-[0.35]" viewBox="0 0 56 48" fill="none">
          <rect x="2" y="4" width="52" height="40" rx="6" fill="#eff6ff" stroke="#3b82f6" stroke-width="2.5"/>
          <path d="M2 14h52" stroke="#3b82f6" stroke-width="2"/>
          <circle cx="10" cy="9" r="2.5" fill="#ef4444" opacity="0.6"/>
          <circle cx="17" cy="9" r="2.5" fill="#f59e0b" opacity="0.6"/>
          <circle cx="24" cy="9" r="2.5" fill="#22c55e" opacity="0.6"/>
        </svg>
        <svg class="hero-float w-9 h-9 md:w-11 md:h-11 opacity-[0.35]" viewBox="0 0 48 48" fill="none">
          <rect x="4" y="4" width="18" height="18" rx="3" fill="#f0fdf4" stroke="#22c55e" stroke-width="2"/>
          <rect x="26" y="4" width="18" height="8" rx="3" fill="#f0fdf4" stroke="#22c55e" stroke-width="2"/>
          <rect x="26" y="16" width="18" height="6" rx="2" fill="#bbf7d0" opacity="0.5"/>
          <rect x="4" y="26" width="40" height="8" rx="3" fill="#f0fdf4" stroke="#22c55e" stroke-width="2"/>
        </svg>
        <svg class="hero-float-slow w-9 h-9 md:w-11 md:h-11 opacity-[0.35]" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="16" fill="#fef2f2" stroke="#ef4444" stroke-width="2"/>
          <path d="M16 24h16M24 16v16" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- Product screenshot mockup -->
    <div class="mt-6 md:mt-10 mx-auto max-w-4xl">
      <div class="rounded-2xl border border-grey-200/60 shadow-lg overflow-hidden bg-grey-50 p-2 md:p-3">
        <div class="rounded-xl overflow-hidden border border-grey-200/40 bg-white">
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-grey-100 bg-grey-50/50">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green/40"></span>
            </div>
            <div class="flex-1 mx-4">
              <div class="h-5 rounded-md bg-grey-100 flex items-center justify-center">
                <span class="text-[10px] text-grey-400">hartleyplumbing.com.au</span>
              </div>
            </div>
          </div>
          <div class="aspect-[16/9] md:aspect-[16/8] bg-gradient-to-br from-grey-50 to-grey-100 flex items-center justify-center relative overflow-hidden">
            <img src="/thumbnails/hartley.webp" alt="Example website - Hartley Plumbing" class="w-full h-full object-cover object-top" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes hero-float-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-7px) rotate(3deg); }
  }
  .hero-float { animation: hero-float 6s ease-in-out infinite; }
  .hero-float-slow { animation: hero-float-slow 8s ease-in-out infinite; }
</style>
