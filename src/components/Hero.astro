---
---

<section id="hero" class="relative overflow-hidden bg-white">
  <div class="relative pt-20 pb-10 md:pt-32 md:pb-16 px-5">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-grey-50 border border-grey-200/60 text-[12px] font-medium text-grey-500 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Sydney Web Design
      </div>

      <h1 class="font-display text-[34px] md:text-[60px] lg:text-[72px] leading-[1.08] text-dark tracking-[-0.02em]">
        The better way to<br class="hidden sm:block" />
        <span class="relative">
          <span class="relative z-10">get your business</span>
          <svg class="absolute -bottom-1 left-0 w-full h-3 text-orange/20 z-0" viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M0 8c40-6 80-6 100-2s60 4 100-2" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/></svg>
        </span> online
      </h1>

      <p class="mt-5 md:mt-6 text-[15px] md:text-[17px] text-grey-500 leading-[1.65] max-w-lg mx-auto">
        Custom-designed websites for local businesses in Sydney. Hand-coded, mobile-first, live in 10 days. <span class="font-semibold text-dark">$1,999 all-in.</span>
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#pricing" class="btn-primary group">
          Get started — $999 deposit
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/book" class="btn-secondary group">
          Book a free call
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Social proof row -->
      <div class="mt-8 flex items-center justify-center gap-3">
        <div class="flex -space-x-2">
          <div class="w-7 h-7 rounded-full bg-orange-light border-2 border-white flex items-center justify-center text-[9px] font-bold text-orange">H</div>
          <div class="w-7 h-7 rounded-full bg-blue-light border-2 border-white flex items-center justify-center text-[9px] font-bold text-blue">K</div>
          <div class="w-7 h-7 rounded-full bg-green-light border-2 border-white flex items-center justify-center text-[9px] font-bold text-green">A</div>
          <div class="w-7 h-7 rounded-full bg-purple-light border-2 border-white flex items-center justify-center text-[9px] font-bold text-purple">+5</div>
        </div>
        <div class="flex items-center gap-1">
          <div class="flex">
            {[1,2,3,4,5].map(() => (
              <svg class="w-3.5 h-3.5 text-amber" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="text-[12px] text-grey-400 ml-0.5">Loved by local businesses</span>
        </div>
      </div>
    </div>

    <!-- Product screenshot mockup -->
    <div class="mt-10 md:mt-14 mx-auto max-w-4xl">
      <div class="rounded-2xl border border-grey-200/60 shadow-lg overflow-hidden bg-grey-50 p-2 md:p-3">
        <!-- Browser chrome -->
        <div class="rounded-xl overflow-hidden border border-grey-200/40 bg-white">
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-grey-100 bg-grey-50/50">
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber/40"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green/40"></span>
            </div>
            <div class="flex-1 mx-4">
              <div class="h-5 rounded-md bg-grey-100 flex items-center justify-center">
                <span class="text-[10px] text-grey-400">hartleyplumbing.com.au</span>
              </div>
            </div>
          </div>
          <!-- Screenshot area -->
          <div class="aspect-[16/9] md:aspect-[16/8] bg-gradient-to-br from-grey-50 to-grey-100 flex items-center justify-center relative overflow-hidden">
            <img src="/thumbnails/hartley.webp" alt="Example website - Hartley Plumbing" class="w-full h-full object-cover object-top" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
