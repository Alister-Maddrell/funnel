<section id="hero" class="relative overflow-hidden bg-white">
  <div class="pt-32 pb-20 md:pt-44 md:pb-28 px-5">
    <div class="mx-auto max-w-3xl md:text-center">
      <!-- Hand-drawn icon -->
      <svg class="w-10 h-10 mx-auto md:mx-auto mb-6 opacity-60" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 56 C12 20, 28 8, 56 8" />
        <path d="M44 6 L56 8 L52 20" />
        <path d="M6 52 C10 48, 14 48, 18 52 C22 56, 26 56, 30 52" />
      </svg>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-5">Sydney Web Design</p>
      <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-black leading-[1.05] tracking-tight text-black [text-wrap:balance]">
        Stop losing customers to a bad website
      </h1>
      <p class="mt-6 text-lg md:text-xl text-grey-600 max-w-xl md:mx-auto leading-relaxed">
        Custom-designed websites for local businesses in Sydney. Live in 10 days. <span class="font-semibold text-black">$1,999 all-in.</span>
      </p>
      <div class="mt-5 flex items-center gap-3 md:justify-center">
        <div class="w-8 h-8 rounded-full bg-grey-100 flex items-center justify-center text-xs font-bold text-grey-600">S</div>
        <span class="text-sm text-grey-400">I'm Ster. Web designer, Sydney.</span>
      </div>
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 md:justify-center">
        <a
          href="#portfolio"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-black text-white text-base font-semibold hover:bg-grey-800 transition-colors"
        >
          See my work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <a
          href="https://cal.com/alister-maddrell-rmtqo9/15-min-discovery-call"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-grey-600 hover:text-black transition-colors"
        >
          Or book a free call
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
        </a>
      </div>
      <p class="mt-6 text-xs text-grey-400">No lock-in contracts. No templates. No nonsense.</p>
    </div>
  </div>
  <!-- Subtle bottom border -->
  <div class="section-divider"></div>
</section>
