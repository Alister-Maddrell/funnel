---
---

<!-- Cal.com-style hero: full-width white card on page-bg -->
<section id="hero" class="pt-16 pb-0">
  <div class="cal-card mx-4 sm:mx-6 md:mx-auto md:max-w-[960px] overflow-hidden">
    <div class="px-5 pt-10 pb-8 sm:px-8 sm:pt-14 sm:pb-10 md:px-12 md:pt-16">
      <!-- Badge -->
      <div class="cal-badge fade-in">
        <span class="inline-block w-2 h-2 rounded-full bg-green animate-pulse"></span>
        Sydney Web Design
      </div>

      <!-- Headline -->
      <h1 class="font-display text-[34px] sm:text-[42px] md:text-[56px] font-bold leading-[1.05] tracking-[-0.03em] text-dark mb-4 fade-in">
        The better way to get your business online
      </h1>

      <!-- Subtext -->
      <p class="text-[15px] sm:text-[16px] leading-relaxed text-grey-500 max-w-[400px] mb-6 fade-in">
        Custom-designed websites for local businesses in Sydney. Hand-coded, mobile-first, live in 10 days. <strong class="text-dark font-semibold">$1,999 all-in.</strong>
      </p>

      <!-- CTA pair - cal.com style -->
      <div class="flex items-center gap-3 mb-8 fade-in">
        <a href="/book" class="btn-primary btn-arrow">Get started</a>
        <a href="#pricing" class="btn-secondary btn-arrow">See pricing</a>
      </div>

      <!-- Small note -->
      <p class="text-[12px] text-grey-400 fade-in">No credit card required</p>
    </div>

    <!-- Product mockup - cal.com style card within card -->
    <div class="px-4 pb-6 sm:px-6 md:px-10 fade-in">
      <div class="rounded-xl border border-grey-200 bg-grey-50 overflow-hidden shadow-sm">
        <!-- Browser chrome -->
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-grey-200 bg-white">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green/60"></span>
          </div>
          <div class="flex-1 mx-3">
            <div class="bg-grey-100 rounded-md px-3 py-1 text-[11px] text-grey-400 text-center font-mono">
              hartleyplumbing.com.au
            </div>
          </div>
        </div>
        <!-- Screenshot -->
        <div class="aspect-[16/9] md:aspect-[16/8] overflow-hidden bg-grey-100">
          <img src="/thumbnails/hartley.webp" alt="Example website - Hartley Plumbing" loading="eager" class="w-full h-full object-cover object-top" />
        </div>
      </div>
    </div>

    <!-- Social proof row - cal.com review badges style -->
    <div class="flex items-center justify-center gap-6 px-5 pb-6 fade-in">
      <div class="flex flex-col items-center gap-1">
        <div class="flex gap-0.5">
          {[1,2,3,4,5].map(() => (
            <svg class="w-3.5 h-3.5 text-amber" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <span class="text-[10px] text-grey-400 font-medium">Hand-coded</span>
      </div>
      <div class="w-px h-6 bg-grey-200"></div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-[14px] font-bold text-dark">10 days</span>
        <span class="text-[10px] text-grey-400 font-medium">Delivery</span>
      </div>
      <div class="w-px h-6 bg-grey-200"></div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-[14px] font-bold text-dark">&lt; 2s</span>
        <span class="text-[10px] text-grey-400 font-medium">Load time</span>
      </div>
    </div>
  </div>
</section>
