---
const metrics = [
  { value: "10", label: "Day delivery" },
  { value: "< 2s", label: "Load time" },
  { value: "100%", label: "Hand-coded" },
  { value: "24/7", label: "Always on" },
];
---

<div class="py-8 md:py-10 px-5 bg-white">
  <div class="mx-auto max-w-3xl grid grid-cols-4 gap-3 md:gap-5">
    {metrics.map((m) => (
      <div class="text-center bg-grey-50 border border-grey-200/50 rounded-xl py-4 px-2">
        <p class="font-display text-[20px] md:text-[28px] text-dark leading-none">{m.value}</p>
        <p class="mt-1.5 text-[10px] md:text-[12px] text-grey-400 font-medium">{m.label}</p>
      </div>
    ))}
  </div>
</div>
