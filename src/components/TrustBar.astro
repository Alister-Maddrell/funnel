---
const metrics = [
  { value: "10+", label: "Sites launched" },
  { value: "5★", label: "Google reviews" },
  { value: "10", label: "Day turnaround" },
  { value: "$0", label: "Hidden fees" },
];
---

<div class="py-8 px-5 bg-grey-50 border-y border-grey-200/40">
  <div class="mx-auto max-w-4xl flex items-center justify-center gap-8 md:gap-16 flex-wrap">
    {metrics.map((m) => (
      <div class="flex items-center gap-2.5">
        <span class="text-base font-bold text-dark tracking-tight">{m.value}</span>
        <span class="text-xs font-medium text-grey-400 uppercase tracking-wide">{m.label}</span>
      </div>
    ))}
  </div>
</div>
