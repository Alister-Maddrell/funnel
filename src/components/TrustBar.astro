---
const metrics = [
  { value: "10", label: "Day delivery", color: "text-blue" },
  { value: "< 2s", label: "Load time", color: "text-orange" },
  { value: "100%", label: "Hand-coded", color: "text-green" },
  { value: "24/7", label: "Always on", color: "text-purple" },
];
---

<div class="py-8 md:py-10 px-5 border-y border-grey-200/40 bg-white">
  <div class="mx-auto max-w-3xl grid grid-cols-4 gap-4 md:gap-8">
    {metrics.map((m) => (
      <div class="text-center">
        <p class={`font-display text-[20px] md:text-[28px] ${m.color} leading-none`}>{m.value}</p>
        <p class="mt-1.5 text-[10px] md:text-[12px] text-grey-400 font-medium">{m.label}</p>
      </div>
    ))}
  </div>
</div>
