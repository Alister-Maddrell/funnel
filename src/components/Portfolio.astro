---
const projects = [
  { src: "/thumbnails/hartley.webp", alt: "Hartley Plumbing website", name: "Hartley & Co", type: "Plumbing", url: "hartleyplumbing.com.au" },
  { src: "/thumbnails/cafe.webp", alt: "Kin Grain Cafe website", name: "Kin Grain", type: "Cafe", url: "kingraincafe.com.au" },
  { src: "/thumbnails/fitness.webp", alt: "Apex Fitness website", name: "Apex Fitness", type: "Gym", url: "apexfitness.com.au" },
];
---

<!-- Cal.com-style portfolio / "Stand out" section -->
<section id="portfolio" class="cal-section">
  <div class="cal-section-inner">
    <!-- Header -->
    <div class="mb-8 fade-in">
      <div class="cal-badge">
        <svg class="text-blue" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v1H2V3zm0 2h12v7a2 2 0 01-2 2H4a2 2 0 01-2-2V5z"/></svg>
        Recent work
      </div>
      <h2 class="cal-h2">Built this week, not last year</h2>
      <p class="cal-subtext">No templates. No page builders. Every site designed and coded from scratch for each business.</p>
    </div>

    <!-- Project cards -->
    <div class="flex flex-col gap-4 fade-in-stagger">
      {projects.map((p) => (
        <div class="cal-card group fade-in hover:shadow-md transition-all duration-200">
          <!-- Browser chrome -->
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-grey-200">
            <div class="flex gap-1.5">
              <span class="w-2 h-2 rounded-full bg-grey-300"></span>
              <span class="w-2 h-2 rounded-full bg-grey-300"></span>
              <span class="w-2 h-2 rounded-full bg-grey-300"></span>
            </div>
            <div class="flex-1 mx-2">
              <div class="bg-grey-50 rounded px-3 py-0.5 text-[11px] text-grey-400 text-center font-mono">{p.url}</div>
            </div>
          </div>
          <!-- Screenshot -->
          <div class="aspect-[16/9] overflow-hidden bg-grey-50">
            <img src={p.src} alt={p.alt} loading="lazy" class="w-full h-full object-cover object-top group-hover:scale-[1.01] transition-transform duration-500" />
          </div>
          <!-- Footer -->
          <div class="flex items-center justify-between px-4 py-3 border-t border-grey-200">
            <div>
              <span class="text-[14px] font-semibold text-dark">{p.name}</span>
              <span class="text-[12px] text-grey-400 ml-2">{p.type}</span>
            </div>
            <svg class="w-4 h-4 text-grey-400 group-hover:text-dark group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- View all link -->
    <div class="mt-6 text-center fade-in">
      <a href="https://portfolio.maddrelldesign.com" target="_blank" rel="noopener" class="btn-secondary btn-arrow">
        View all projects
      </a>
    </div>
  </div>
</section>
