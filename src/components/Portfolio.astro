---
const projects = [
  { src: "/thumbnails/hartley.webp", alt: "Hartley Plumbing website", name: "Hartley & Co", type: "Plumbing" },
  { src: "/thumbnails/cafe.webp", alt: "Kin Grain Cafe website", name: "Kin Grain", type: "Cafe" },
  { src: "/thumbnails/fitness.webp", alt: "Apex Fitness website", name: "Apex Fitness", type: "Gym" },
];
---

<section id="portfolio" class="py-24 md:py-32 px-5 bg-white">
  <div class="mx-auto max-w-5xl">
    <div class="md:flex md:items-end md:justify-between mb-14">
      <div>
        <!-- Hand-drawn browser/gallery illustration -->
        <svg class="w-12 h-12 mb-5" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="6" width="44" height="36" rx="6" stroke="#1a3a5c" stroke-width="1.5" fill="none"/>
          <path d="M2 14 L46 14" stroke="#1a3a5c" stroke-width="1" opacity="0.3"/>
          <circle cx="10" cy="10" r="2" fill="#e8635a" opacity="0.6"/>
          <circle cx="17" cy="10" r="2" fill="#f5c542" opacity="0.6"/>
          <circle cx="24" cy="10" r="2" fill="#5cbd6a" opacity="0.6"/>
          <rect x="8" y="20" width="14" height="16" rx="3" fill="#1a3a5c" opacity="0.06" stroke="#1a3a5c" stroke-width="0.75" opacity="0.15"/>
          <rect x="26" y="20" width="14" height="16" rx="3" fill="#1a3a5c" opacity="0.06" stroke="#1a3a5c" stroke-width="0.75" opacity="0.15"/>
          <path d="M11 26 L19 26" stroke="#1a3a5c" stroke-width="1" opacity="0.2" stroke-linecap="round"/>
          <path d="M11 30 L17 30" stroke="#1a3a5c" stroke-width="1" opacity="0.15" stroke-linecap="round"/>
        </svg>
        <div class="tag mb-6">Recent work</div>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] tracking-[-0.02em] text-black">
          Built this week, not last year
        </h2>
        <p class="mt-3 text-grey-500 leading-relaxed max-w-lg text-sm">
          No templates. No page builders. Every site designed and coded from scratch.
        </p>
      </div>
      <a
        href="https://portfolio.maddrelldesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex btn-secondary"
      >
        View all projects
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>

    <!-- Bento grid: 2 top, 1 wide bottom -->
    <div class="grid md:grid-cols-2 gap-5">
      {projects.slice(0, 2).map((p) => (
        <div class="group bg-grey-50 rounded-2xl border border-grey-200/40 shadow-card overflow-hidden">
          <div class="p-3 pb-0">
            <div class="rounded-xl overflow-hidden">
              <img src={p.src} alt={p.alt} class="w-full h-auto group-hover:scale-[1.015] transition-transform duration-500" loading="lazy" />
            </div>
          </div>
          <div class="px-5 py-4 flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-dark">{p.name}</p>
              <p class="text-xs text-grey-400 mt-0.5">{p.type}</p>
            </div>
            <svg class="w-4 h-4 text-grey-300 group-hover:text-dark transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-5">
      <div class="group bg-white rounded-2xl border border-grey-200/60 shadow-card overflow-hidden">
        <div class="p-3 pb-0">
          <div class="rounded-xl overflow-hidden">
            <img src={projects[2].src} alt={projects[2].alt} class="w-full h-auto group-hover:scale-[1.015] transition-transform duration-500" loading="lazy" />
          </div>
        </div>
        <div class="px-5 py-4 flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-dark">{projects[2].name}</p>
            <p class="text-xs text-grey-400 mt-0.5">{projects[2].type}</p>
          </div>
          <svg class="w-4 h-4 text-grey-300 group-hover:text-dark transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
        </div>
      </div>
    </div>

    <!-- Mobile CTA -->
    <div class="mt-8 md:hidden">
      <a
        href="https://portfolio.maddrelldesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        View all projects
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>
</section>
