---
const projects = [
  { src: "/thumbnails/hartley.webp", alt: "Hartley Plumbing website", name: "Hartley & Co", type: "Plumbing" },
  { src: "/thumbnails/cafe.webp", alt: "Kin Grain Cafe website", name: "Kin Grain", type: "Cafe" },
  { src: "/thumbnails/fitness.webp", alt: "Apex Fitness website", name: "Apex Fitness", type: "Gym" },
];
---

<section id="portfolio" class="py-20 md:py-28 px-5">
  <div class="mx-auto max-w-5xl">
    <!-- Hand-drawn icon -->
    <svg class="w-8 h-8 mb-4 opacity-50" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="12" width="52" height="36" rx="4" />
      <path d="M6 20 L58 20" />
      <circle cx="14" cy="16" r="2" fill="currentColor" />
      <circle cx="22" cy="16" r="2" fill="currentColor" />
      <circle cx="30" cy="16" r="2" fill="currentColor" />
      <rect x="12" y="26" width="18" height="4" rx="1" fill="currentColor" opacity="0.2" />
      <rect x="12" y="34" width="14" height="4" rx="1" fill="currentColor" opacity="0.1" />
    </svg>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-grey-400 mb-3">Recent Work</p>
    <h2 class="text-[clamp(1.75rem,4vw,2.75rem)] font-black leading-tight tracking-tight text-black">
      Built this week, not last year
    </h2>
    <p class="mt-4 text-grey-600 leading-relaxed max-w-lg">
      No templates. No page builders. Every site designed and coded from scratch.
    </p>

    <!-- Stacked full-width project cards with labels -->
    <div class="mt-12 space-y-6">
      {projects.map((p) => (
        <div class="group rounded-2xl bg-grey-50 border border-grey-200/60 overflow-hidden hover:shadow-md transition-shadow">
          <div class="overflow-hidden">
            <img src={p.src} alt={p.alt} class="w-full h-auto group-hover:scale-[1.01] transition-transform duration-500" loading="lazy" />
          </div>
          <div class="px-6 py-4 flex items-center justify-between">
            <div>
              <p class="text-sm font-bold text-black">{p.name}</p>
              <p class="text-xs text-grey-400">{p.type}</p>
            </div>
            <svg class="w-4 h-4 text-grey-400 group-hover:text-black transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <a
        href="https://portfolio.maddrelldesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-grey-200 text-black text-sm font-semibold hover:bg-grey-50 hover:border-grey-400 transition-all"
      >
        Explore the full portfolio
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 7l-10 10M17 7H7m10 0v10"/></svg>
      </a>
    </div>
  </div>
</section>

<div class="section-divider mx-5"></div>
