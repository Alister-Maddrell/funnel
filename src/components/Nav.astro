---

<nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 px-4 transition-all duration-300">
  <div id="nav-pill" class="mx-auto max-w-lg mt-2.5 px-4 py-2 rounded-2xl flex items-center justify-between transition-all duration-300 bg-white/60 backdrop-blur-xl border-[1.5px] border-grey-200/30 shadow-xs">
    <a href="mailto:alistermaddrell@gmail.com" class="text-[13px] font-bold tracking-tight text-dark hover:text-highlight transition-colors">
      Alister Maddrell
    </a>
    <div class="flex items-center gap-1">
      <a
        href="https://portfolio.maddrelldesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg text-[12px] font-medium text-grey-500 hover:text-dark hover:bg-grey-50 transition-all"
      >
        Portfolio
      </a>
      <a
        href="/book"
        class="px-3 py-1.5 rounded-lg bg-dark text-white text-[12px] font-semibold hover:bg-black transition-colors"
      >
        Book a call
      </a>
    </div>
  </div>
</nav>

<script>
  const navPill = document.getElementById('nav-pill');
  if (navPill) {
    let ticking = false;
    const updateNav = () => {
      if (window.scrollY > 100) {
        navPill.classList.remove('bg-white/60', 'border-grey-200/30');
        navPill.classList.add('bg-white/90', 'border-grey-200/60', 'shadow-sm');
      } else {
        navPill.classList.add('bg-white/60', 'border-grey-200/30');
        navPill.classList.remove('bg-white/90', 'border-grey-200/60', 'shadow-sm');
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateNav);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
