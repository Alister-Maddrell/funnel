    <div class="flex flex-col gap-0.5">
      <a href="https://portfolio.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-[14px] text-grey-700 hover:bg-grey-50 transition-colors">
        Portfolio <svg class="w-3.5 h-3.5 text-grey-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
      </a>
      <a href="#pricing" class="px-3 py-2.5 rounded-lg text-[14px] text-grey-700 hover:bg-grey-50 transition-colors">Pricing</a>
      <a href="#faq" class="px-3 py-2.5 rounded-lg text-[14px] text-grey-700 hover:bg-grey-50 transition-colors">FAQ</a>
      <a href="/book" class="px-3 py-2.5 rounded-lg text-[14px] text-grey-700 hover:bg-grey-50 transition-colors">Book a call</a>
      <a href="mailto:alistermaddrell@gmail.com" class="px-3 py-2.5 rounded-lg text-[14px] text-grey-700 hover:bg-grey-50 transition-colors">Email me</a>
    </div>
    <!-- Demo sites -->
    <div class="border-t border-grey-100 mt-2 pt-2">
      <p class="px-3 py-1 text-[11px] font-semibold text-grey-400 uppercase tracking-wider">Demo Sites</p>
      <a href="https://hartley.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Hartley Plumbing <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://cafe.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Kin Grain Cafe <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://fitness.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Apex Fitness <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://beauty.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Luma Beauty <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://accounting.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Whitfield Accounting <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://events.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Evergreen Events <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
      <a href="https://saas.maddrelldesign.com" target="_blank" rel="noopener" class="flex items-center justify-between px-3 py-2 rounded-lg text-[13px] text-grey-500 hover:bg-grey-50 transition-colors">
        Flowline SaaS <svg class="w-3 h-3 text-grey-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </a>
    </div>
  </div>
</nav>

<script>
  const navBar = document.getElementById('nav-bar');
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        if (window.scrollY > 60) {
          navBar?.classList.add('bg-white/90', 'backdrop-blur-lg', 'border-b', 'border-grey-200/60', 'shadow-xs');
          navBar?.classList.remove('bg-transparent');
        } else {
          navBar?.classList.remove('bg-white/90', 'backdrop-blur-lg', 'border-b', 'border-grey-200/60', 'shadow-xs');
          navBar?.classList.add('bg-transparent');
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
  document.getElementById('mobile-menu')?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => document.getElementById('mobile-menu')?.classList.add('hidden'));
  });
</script>
