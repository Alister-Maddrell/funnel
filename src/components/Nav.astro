      Maddrell
      <svg class="w-3 h-3 text-grey-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
    </a>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <a href="https://portfolio.maddrelldesign.com" target="_blank" rel="noopener" class="hidden sm:inline-flex text-[13px] font-medium text-grey-600 hover:text-dark transition-colors px-2 py-1">
        Portfolio
      </a>
      <a href="/book" class="inline-flex items-center gap-1 px-3.5 py-[7px] rounded-lg bg-dark text-white text-[13px] font-medium hover:bg-black transition-colors">
        Get started
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      </a>
      <button id="menu-toggle" class="sm:hidden flex items-center justify-center w-8 h-8 rounded-lg hover:bg-grey-200/50 transition-colors" aria-label="Menu">
        <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
